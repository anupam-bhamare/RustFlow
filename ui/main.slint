                                                active_node_index = index;

                                                menu_x = self.mouse-x + parent.x + left * 1px - pad * 1px + root.canvas_pan_x + 260px;
                                                menu_y = self.mouse-y + parent.y + top * 1px - pad * 1px + root.canvas_pan_y;

                                                menu_visible = true;
                                                return EventResult.accept;
                                            }
                                            return EventResult.reject;
                                        }
                                        clicked => {
                                            root.select_connection(index);
                                            root.selected_index = -1;
                                            menu_visible = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if menu_visible: Rectangle {
            x: menu_x;
            y: menu_y;
            width: 160px;
            height: 210px;
            background: #ffffff;
            border-radius: 6px;
            border-width: 1px;
            border-color: #dcdcdc;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                Rectangle {
                    background: cut-t.has-hover ? #f0f0f0 : transparent;
                    height: 26px;
                    border-radius: 4px;
                    Text {
                        text: "Cut";
                        x: 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 13px;
                    }

                    Text {
                        text: "ctrl-x";
                        x: parent.width - self.width - 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 11px;
                        color: #888888;
                    }

                    cut-t := TouchArea {
                        clicked => {
                            menu_visible = false;
                            root.cut_selected_subgraph(root.selected_indexes);
                        }
                    }
                }

                Rectangle {
                    background: copy-t.has-hover ? #f0f0f0 : transparent;
                    height: 26px;
                    border-radius: 4px;
                    Text {
                        text: "Copy";
                        x: 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 13px;
                    }

                    Text {
                        text: "ctrl-c";
                        x: parent.width - self.width - 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 11px;
                        color: #888888;
                    }

                    copy-t := TouchArea {
                        clicked => {

                            debug("Copy click selected_indexes count: ", root.backup_selected_indexes.length);
                            root.copy_selected_subgraph(root.backup_selected_indexes);
                            menu_visible = false;
                        }
                    }
                }

                Rectangle {
                    background: paste-t.has-hover ? #f0f0f0 : transparent;
                    height: 26px;
                    border-radius: 4px;
                    Text {
                        text: "Paste";
                        x: 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 13px;
                    }

                    Text {
                        text: "ctrl-v";
                        x: parent.width - self.width - 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 11px;
                        color: #888888;
                    }

                    paste-t := TouchArea {
                        clicked => {
                            menu_visible = false;

                            root.paste_selected_subgraph(    (-root.canvas_pan_x / 1px) + 300,     (-root.canvas_pan_y / 1px) + 200);
                        }
                    }
                }

                Rectangle {
                    background: del-t.has-hover ? #f0f0f0 : transparent;
                    height: 26px;
                    border-radius: 4px;
                    Text {
                        text: "Delete";
                        x: 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 13px;
                    }

                    Text {
                        text: "del";
                        x: parent.width - self.width - 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 11px;
                        color: #888888;
                    }

                    del-t := TouchArea {
                        clicked => {
                            menu_visible = false;
                            if (root.selected_index != -1) {
                                root.delete_selected_symbol();
                            } else {

                                root.delete_selected_connection();
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #e8e8e8;
                }

                Rectangle {
                    background: u.has-hover ? #f0f0f0 : transparent;
                    height: 26px;
                    border-radius: 4px;
                    Text {
                        text: "Undo";
                        x: 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 13px;
                    }

                    Text {
                        text: "ctrl-z";
                        x: parent.width - self.width - 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 11px;
                        color: #888888;
                    }

                    u := TouchArea {
                        clicked => {
                            root.undo_action();
                            menu_visible = false;
                        }
                    }
                }

                Rectangle {
                    background: r.has-hover ? #f0f0f0 : transparent;
                    height: 26px;
                    border-radius: 4px;
                    Text {
                        text: "Redo";
                        x: 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 13px;
                    }

                    Text {
                        text: "ctrl-y";
                        x: parent.width - self.width - 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 11px;
                        color: #888888;
                    }

                    r := TouchArea {
                        clicked => {
                            menu_visible = false;
                            root.redo_action();
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #e8e8e8;
                }

                Rectangle {
                    background: sel-t.has-hover ? #f0f0f0 : transparent;
                    height: 26px;
                    border-radius: 4px;
                    Text {
                        text: "Select All";
                        x: 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 13px;
                    }

                    Text {
                        text: "ctrl-a";
                        x: parent.width - self.width - 8px;
                        vertical-alignment: center;
                        height: 100%;
                        font-size: 11px;
                        color: #888888;
                    }

                    sel-t := TouchArea {
                        clicked => {
                            root.select_all();
                            root.backup_selected_indexes = root.selected_indexes;
                            debug("Select all backup_selected_indexes count: ", root.backup_selected_indexes.length);

                            menu_visible = false;
                        }
                    }
                }
            }
        }

        if (root.show_node_modal): Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000044;

            TouchArea { }

            Rectangle {
                width: 360px;
                height: 240px;
                background: white;
                border-radius: 8px;
                border-width: 1px;
                border-color: #e0e0e0;
                clip: true;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    Text {
                        text: "Edit Node Properties";
                        font-size: 16px;
                        font-weight: 700;
                        color: #222222;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: "Label:";
                            vertical-alignment: center;
                            font-size: 13px;
                            font-weight: 500;
                            color: #555555;
                            width: 50px;
                        }

                        Rectangle {
                            background: #f8f9fa;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #cccccc;
                            height: 32px;

                            TextInput {
                                text: root.edit_label;
                                font-size: 13px;
                                vertical-alignment: center;
                                single-line: true;

                                x: 8px;
                                width: parent.width - 16px;

                                edited => {
                                    root.edit_label = self.text;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: "Value:";
                            vertical-alignment: center;
                            font-size: 13px;
                            font-weight: 500;
                            color: #555555;
                            width: 50px;
                        }

                        Rectangle {
                            background: #f8f9fa;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #cccccc;
                            height: 32px;

                            TextInput {
                                text: root.edit_value;
                                font-size: 13px;
                                vertical-alignment: center;
                                single-line: true;
                                x: 8px;
                                width: parent.width - 16px;

                                edited => {
                                    root.edit_value = self.text;
                                }
                            }
                        }
                    }

                    Rectangle { }

                    // --- Modal Actions ---
            HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        Button {
                            text: "Close";
                            width: 85px;
                            height: 32px;
                            primary: true;
                            clicked => {
                                root.show_node_modal = false;
                            }
                        }

                        Button {
                            text: "Save";
                            width: 85px;
                            height: 32px;
                            primary: true;
                            clicked => {
                                root.save_node_properties(root.editing_index, root.edit_label, root.edit_value);
                                root.show_node_modal = false;
                            }
                        }
                    }
                }
            }
        }

        if (root.show_alert): Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000044;

            TouchArea { }

            Rectangle {
                width: 320px;
                height: 180px;
                background: white;
                border-radius: 8px;
                border-width: 1px;
                border-color: #dddddd;
                clip: true;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        text: "Notification";
                        font-size: 16px;
                        font-weight: 700;
                        color: #333333;
                    }

                    Text {
                        text: root.alert_message;
                        font-size: 14px;
                        color: #555555;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }

                    HorizontalLayout {
                        alignment: center;

                        Button {
                            text: "Ok";
                            width: 100px;
                            primary: true;
                            clicked => {
                                root.show_alert = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
