                            Rectangle {
                                height: 36px;
                                background: pastel_touch.has-hover ? rgb(195, 195, 140) : rgb(215, 215, 160);
                                border-radius: 4px;

                                Text {
                                    text: (root.network_expanded ? "▼ " : "▶ ") + "Network";
                                    color: white;
