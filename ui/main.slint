import { Button } from "std-widgets.slint";

export struct SymbolEntry {
    name: string,
    label: string,
    value: string,
    x: float,
    y: float,
    node_type: string,
    bg_color: string,
    creation_mode: int,
    is_selected: bool,
}

export struct Connection {
    from_index: int,
    to_index: int,
    selected: bool,
    creation_mode: int,
    from_port: string,
    to_port: string,
}

struct LibraryItem {
    name: string,
    node_type: string,
}

component NodeSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode;

    width: 120px;
    height: 40px;
    background: #e1f5fe.with-alpha(0.5);
    border-width: 1px;
    border-color: #0288d1;
    border-radius: 4px;

    if (root.creation_mode == 0 || root.creation_mode == 2): Rectangle {
        x: -5px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: input_touch.has-hover ? orange : #0288d1;
        input_touch := TouchArea {
            clicked => {
                root.port_clicked(true, "left");
            }
        }
    }

    if (root.creation_mode == 0 || root.creation_mode == 2): Rectangle {
        x: 115px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: output_touch.has-hover ? orange : #0288d1;
        output_touch := TouchArea {
            clicked => {
                root.port_clicked(false,"right");
            }
        }
    }

    if (root.creation_mode == 1 || root.creation_mode == 2): Rectangle {
        x: (parent.width / 2) - 5px;
        y: -5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: top_touch.has-hover ? orange : #0288d1;
        top_touch := TouchArea {
            clicked => {
                root.port_clicked(true, "top");
            }
        }
    }

    if (root.creation_mode == 1 || root.creation_mode == 2): Rectangle {
        x: (parent.width / 2) - 5px;
        y: parent.height - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: bottom_touch.has-hover ? orange : #0288d1;
        bottom_touch := TouchArea {
            clicked => {
                root.port_clicked(false,"bottom");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component InputConnectorSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode: 0;

    width: 60px;
    height: 40px;
    background: #bae2b1.with-alpha(0.5);
    border-width: 1px;
    border-color: #8ba47c;
    border-radius: 4px;

    Rectangle {
        x: -5px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: input_touch.has-hover ? orange : #8ba47c;
        input_touch := TouchArea {
            clicked => {
                root.port_clicked(true, "left");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component OutputConnectorSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode: 0;

    width: 60px;
    height: 40px;
    background: #bae2b1.with-alpha(0.5);
    border-width: 1px;
    border-color: #8ba47c;
    border-radius: 4px;

    Rectangle {
        x: 55px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: output_touch.has-hover ? orange : #8ba47c;
        output_touch := TouchArea {
            clicked => {
                root.port_clicked(false,"right");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {

    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1024px;
    min-height: 700px;

    property <bool> common_expanded: false;
    property <bool> function_expanded: false;
    property <bool> parser_expanded: false;
    property <bool> storage_expanded: false;
    property <bool> dashboard_expanded: false;
    property <bool> network_expanded: false;
    property <bool> actions_expanded: false;
    property <bool> layout_expanded: false;
    property <bool> connectors_expanded: false;
    property <bool> prevent_placement: false;
    property <bool> is_panning: false;
    property <[int]> backup_selected_indexes: [];
    property <length> menu_x: 0px;
    property <length> menu_y: 0px;
    property <bool> menu_visible: false;
    property <int> active_node_index: -1;
    property <float> pan_start_x: 0;
    property <float> pan_start_y: 0;
    in-out property <[SymbolEntry]> nodes: [];
    in-out property <int> selected_node_index: -1;
    in-out property <[int]> selected_indexes: [];
    in-out property <[SymbolEntry]> all_symbols: [];
    in-out property <[Connection]> connections: [];
    in-out property <[SymbolEntry]> ghost_symbols: [];
    in-out property <[Connection]> ghost_connections: [];
    in-out property <bool> is_pasting_mode: false;
    in-out property <length> live_mouse_x: 0px;
    in-out property <length> live_mouse_y: 0px;
    in-out property <length> canvas_pan_x: 0px;
    in-out property <length> canvas_pan_y: 0px;
    in-out property <int> active_layout_mode: 0;
    in-out property <bool> show_alert: false;
    in-out property <string> alert_message: "";
    in-out property <bool> is_dragging: false;
    in-out property <string> drag_name: "";
    in-out property <int> creation_mode: 0;
    in-out property <string> drag_type: "";
    in-out property <string> bg_color: "";
    in-out property <float> drag_x: 0;
    in-out property <float> drag_y: 0;
    in-out property <bool> show_node_modal: false;
    in-out property <string> edit_label: "";
    in-out property <string> edit_value: "";
    in-out property <int> editing_index: -1;
    in-out property <int> selected_index: -1;

    callback delete_selected_symbols();
    callback select_all();
    callback cut_nodes();
    callback copy_selected_subgraph([int]);
    callback paste_selected_subgraph(float, float);
    callback cut_selected_subgraph([int]);
    callback node_clicked(int, bool);
    callback canvas_clicked();
    callback copy_node(int);
    callback cut_node(int);
    callback undo_action();
    callback redo_action();
    callback vertical_layout();
    callback horizontal_layout();
    callback save_node_properties(int, string, string);
    callback select_library_symbol(string);
    callback place_symbol(string, string, string, float, float, int);
    callback update_symbol_position(int, float, float);
    callback delete_selected_symbol();
    callback clear_canvas();
    callback import_xml();
    callback handle_port_click(int, bool, int, string);
    callback select_connection(int);
    callback delete_selected_connection();
    callback save_flow();
    callback load_flow();

    TouchArea {
        clicked => {
            menu_visible = false;
        }
    }

    public function trigger_alert(msg: string) {
        root.alert_message = msg;
        root.show_alert = true;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        HorizontalLayout {
            width: 100%;
            height: 100%;

            Rectangle {
                width: 260px;
                background: #f7f7f7;
                border-width: 1px;
                border-color: #dcdcdc;
                TouchArea {
                    clicked => {
                        menu_visible = false;
                    }
                }

                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;

                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: sidebar-content.min-height;

                        sidebar-content := VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            Rectangle {
                                height: 36px;
                                background: rgb(166, 187, 207);
                                border-radius: 4px;

                                Text {
                                    text: (root.common_expanded ? "▼ " : "▶ ") + "Common";
                                    color: white;
                                    font-weight: 700;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.common_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.common_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.common_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in [
                                    { name: "Text", node_type: "ui_text" },
                                    { name: "Button", node_type: "ui_button" },
                                    { name: "Dropdown", node_type: "ui_dropdown" }
                                ]: Rectangle {
                                    height: 35px;
                                    background: common-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node.name;
                                        color: black;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    common-touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node.name;
                                            root.drag_type = node.node_type;
                                            root.select_library_symbol(node.name);

                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: rgb(253, 208, 162);
                                border-radius: 4px;

                                Text {
                                    text: (root.function_expanded ? "▼ " : "▶ ") + "Function";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.function_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.function_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.function_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Switch", "Change", "Range", "Delay", "Trigger"]: Rectangle {
                                    height: 35px;
                                    background: function-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: black;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    function_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node;
                                            root.select_library_symbol(node);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: rgb(222, 189, 92);
                                border-radius: 4px;

                                Text {
                                    text: (root.parser_expanded ? "▼ " : "▶ ") + "Parser";
                                    color: white;
                                    font-weight: 700;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.parser_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.parser_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.parser_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Json", "Xml", "Csv", "Html"]: Rectangle {
                                    height: 35px;
                                    background: parser-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: black;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    parser_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node;
                                            root.select_library_symbol(node);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: burlywood;
                                border-radius: 4px;

                                Text {
                                    text: (root.storage_expanded ? "▼ " : "▶ ") + "Storage";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.storage_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.storage_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.storage_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Text", "Button", "Dropdown"]: Rectangle {
                                    height: 35px;
                                    background: storage-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: black;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    storage_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node;
                                            root.select_library_symbol(node);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: rgb(119, 198, 204);
                                border-radius: 4px;

                                Text {
                                    text: (root.dashboard_expanded ? "▼ " : "▶ ") + "Dashboard";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.dashboard_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.dashboard_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.dashboard_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Chart", "Gauge", "Slider"]: Rectangle {
                                    height: 35px;
                                    background: dashboard-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    dashboard_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node;
                                            root.select_library_symbol(node);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: rgb(215, 215, 160);
                                border-radius: 4px;

                                Text {
                                    text: (root.network_expanded ? "▼ " : "▶ ") + "Network";
                                    color: white;
                                    font-weight: 700;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.network_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.network_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.network_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["MQTT", "HTTP", "TCP"]: Rectangle {
                                    height: 35px;
                                    background: network-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }
                                    Text {
                                        text: node;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    network_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node;
                                            root.select_library_symbol(node);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: #edd1d1;
                                Text {
                                    text: (root.actions_expanded ? "▼ " : "▶ ") + "Actions";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.actions_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.actions_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.actions_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Delete Node", "Delete Wire", "Clear All", "Save Flow", "Load Flow"]: Rectangle {
                                    height: 35px;
                                    background: actions-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    actions-touch := TouchArea {
                                        clicked => {
                                            if (node == "Delete Wire") {
                                                root.delete_selected_connection();
                                            } else if (node == "Delete Node") {
                                                root.delete_selected_symbol();
                                            } else if (node == "Save Flow") {
                                                root.save_flow();
                                            } else if (node == "Load Flow") {
                                                root.load_flow();
                                            } else if (node == "Clear All") {
                                                root.clear_canvas();
                                            } else {
                                                root.is_dragging = true;
                                                root.drag_name = node;
                                                root.select_library_symbol(node);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: #266df2;
                                border-radius: 4px;
                                Text {
                                    text: (root.layout_expanded ? "▼ " : "▶ ") + "Layout";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.layout_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.layout_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.layout_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Horizontal", "Vertical", "Both"]: Rectangle {
                                    height: 35px;
                                    background: layout-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    layout-touch := TouchArea {
                                        clicked => {
                                            if (node == "Horizontal") {
                                                root.active_layout_mode = 0;
                                                root.horizontal_layout();
                                            } else if (node == "Vertical") {
                                                root.active_layout_mode = 1;
                                                root.vertical_layout();
                                            } else if (node == "Both") {
                                                root.active_layout_mode = 2;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: #bbebb2;
                                Text {
                                    text: (root.connectors_expanded ? "▼ " : "▶ ") + "Connectors";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                TouchArea {
                                    clicked => {
                                        let was_open = root.connectors_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;

                                        root.connectors_expanded = !was_open;
                                    }
                                }
                            }

                            if (root.connectors_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in [{ name: "A", node_type: "ip_connector" }, { name: "B", node_type: "op_connector" }]: Rectangle {
                                    height: 35px;
                                    background: connectors_touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node.name;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    connectors_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node.name;
                                            root.drag_type = node.node_type;
                                            root.select_library_symbol(node.name);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 40px;
                        vertical-stretch: 0;
                        HorizontalLayout {
                            spacing: 10px;

                            Rectangle {
                                background: #e06c75;
                                border-radius: 4px;
                                Button {
                                    text: "Del ";
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        if (root.selected_index != -1) {
                                            root.delete_selected_symbol();
                                        } else {

                                            root.delete_selected_connection();
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                background: #d19a66;
                                border-radius: 4px;
                                Button {
                                    text: "Clr ";
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.clear_canvas();
                                    }
                                }
                            }

                            Rectangle {
                                background: #61afef;
                                border-radius: 4px;
                                Button {
                                    text: "Save";
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.save_flow();
                                    }
                                }
                            }

                            Rectangle {
                                background: #98c379;
                                border-radius: 4px;
                                Button {
                                    text: "Load";
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.load_flow();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: #f8f5f5;
                clip: true;

                for i in 250: Rectangle {
                    x: (i * 15) * 1px;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: #e0e0e0;
                }

                for i in 150: Rectangle {
                    x: 0;
                    y: (i * 15) * 1px;
                    width: parent.width;
                    height: 1px;
                    background: #e0e0e0;
                }
                ForwardFocus := FocusScope {
                    width: 100%;
                    height: 100%;

                    key-pressed(event) => {
                        let is_modifier_pressed = event.modifiers.control || event.modifiers.meta;
                        if (is_modifier_pressed) {
                            if (event.text == "c") {
                                debug("Keyboard shortcut Ctrl+C pressed! Selected count: ", root.selected_indexes.length);
                                root.copy_selected_subgraph(root.selected_indexes);
                                return EventResult.accept;
                            }
                            if (event.text == "x") {
                                root.cut_selected_subgraph(root.selected_indexes);
                                accept;
                            }
                            if (event.text == "a") {
                                root.select_all();
                                return EventResult.accept;
                            }
                            if (event.text == "v") {

                                root.paste_selected_subgraph(    (-root.canvas_pan_x / 1px) + 300,     (-root.canvas_pan_y / 1px) + 200);

                                root.selected_index = -1;

                                root.selected_indexes = [];
                                return EventResult.accept;
                            }
                            EventResult.reject;
                        }
                        if (event.text == "z" && event.modifiers.control) {
                            root.undo_action();
                            accept;
                        }
                        if (event.text == "y" && event.modifiers.control) {
                            root.redo_action();
                            accept;
                        }
                        if (event.text == Key.Delete) {
                            if (root.selected_index != -1) {
                                root.delete_selected_symbol();
                                accept;
                            } else {
                                root.delete_selected_connection();
                                accept;
                            }
                        }
                        if (root.selected_index != -1) {
                            let delta: float = event.modifiers.shift ? 1.0 : 2.0;

                            if (event.text == Key.LeftArrow) {
                                root.update_symbol_position(root.selected_index, (root.all_symbols[root.selected_index].x - delta), root.all_symbols[root.selected_index].y);
                                accept;
                            }
                            if (event.text == Key.RightArrow) {
                                root.update_symbol_position(root.selected_index, (root.all_symbols[root.selected_index].x + delta), root.all_symbols[root.selected_index].y);
                                accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.update_symbol_position(root.selected_index, root.all_symbols[root.selected_index].x, (root.all_symbols[root.selected_index].y - delta));
                                accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.update_symbol_position(root.selected_index, root.all_symbols[root.selected_index].x, (root.all_symbols[root.selected_index].y + delta));
                                accept;
                            }
                        }
                        reject;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;

                    property <physical-length> right_click_press_x: 0;
                    property <physical-length> right_click_press_y: 0;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right) {
                            if (event.kind == PointerEventKind.down) {
                                root.is_panning = true;
                                root.pan_start_x = self.mouse-x / 1px;
                                root.pan_start_y = self.mouse-y / 1px;

                                right_click_press_x = self.mouse-x;
                                right_click_press_y = self.mouse-y;
                                menu_visible = false;
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.is_panning = false;
                                let dx = (self.mouse-x - right_click_press_x) / 1px;
                                let dy = (self.mouse-y - right_click_press_y) / 1px;
                                let drag_distance_sq = (dx * dx) + (dy * dy);

                                if (drag_distance_sq < 16) {
                                    root.selected_index = -1;
                                    root.select_connection(-1);
                                    root.selected_indexes = [];
                                    root.node_clicked(-1, false);

                                    menu_x = self.mouse-x + 260px;
                                    menu_y = self.mouse-y;
                                    menu_visible = true;
                                }
                            }
                        }
                        if (event.kind == PointerEventKind.move) {
                            root.live_mouse_x = self.mouse-x;
                            root.live_mouse_y = self.mouse-y;
                        }
                    }

                    moved => {
                        if (root.is_dragging) {
                            root.drag_x = self.mouse-x / 1px;
                            root.drag_y = self.mouse-y / 1px;
                        }
                        if (root.is_panning) {
                            let current_x = self.mouse-x / 1px;
                            let current_y = self.mouse-y / 1px;

                            root.canvas_pan_x += (current_x - root.pan_start_x) * 1px;
                            root.canvas_pan_y += (current_y - root.pan_start_y) * 1px;
                            root.pan_start_x = current_x;
                            root.pan_start_y = current_y;
                        }
                    }

                    clicked => {
                        if (root.is_pasting_mode) {
                            root.canvas_clicked();
                            root.is_pasting_mode = false; // Drops the nodes!
                            } else {
                            menu_visible = false;
                            root.selected_index = -1;
                            root.select_connection(-1);
                            ForwardFocus.focus();
                            root.selected_indexes = [];

                            if (root.is_dragging) {
                                let is_connector = root.drag_name == "A" || root.drag_name == "B";
                                let shape_w = is_connector ? 60 : 120;
                                let shape_h = is_connector ? 40 : 40;
                                let drop_x = root.drag_x;
                                let drop_y = root.drag_y;

                                root.place_symbol(root.drag_name, root.drag_type, "#0d6efd", drop_x, drop_y, root.active_layout_mode);
                                root.is_dragging = false;
                            } else if (root.selected_index != -1) {
                                root.selected_index = -1;
                            }
                        }
                    }

                    if (root.is_dragging): Rectangle {
                        property <bool> is_connector: root.drag_name == "A" || root.drag_name == "B";
                        property <bool> is_InputConnector: root.drag_type == "ip_connector";
                        property <bool> is_OutConnector: root.drag_type == "op_connector";
                        width: is_connector ? 60px : 120px;
                        height: is_connector ? 40px : 40px;
                        x: root.drag_x * 1px - (self.width / 2);
                        y: root.drag_y * 1px - (self.height / 2);
                        opacity: 0.5;

                        if (is_InputConnector): InputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: root.drag_name;
                            creation_mode: root.active_layout_mode;
                        }
                        if (is_OutConnector): OutputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: root.drag_name;
                            creation_mode: root.active_layout_mode;
                        }
                        if (!is_InputConnector && !is_OutConnector): NodeSymbol {
                            width: 100%;
                            height: 100%;
                            label: root.drag_name;
                            creation_mode: root.active_layout_mode;
                        }
                    }
                    for item[i] in root.all_symbols: Rectangle {
                        z: 2;
                        property <bool> is_InputConnector: item.node_type == "ip_connector";
                        property <bool> is_OutConnector: item.node_type == "op_connector";
                        property <bool> is_connector: is_InputConnector || is_OutConnector;
                        width: is_connector ? 60px : 120px;
                        height: is_connector ? 40px : 40px;
                        x: item.x * 1px - 60px + root.canvas_pan_x;
                        y: item.y * 1px - 20px + root.canvas_pan_y;

                        property <bool> node-is-selected: item.is_selected;

                        if (node-is-selected && (root.selected_index == i || root.selected_indexes.length > 1)): Rectangle {
                            border-width: 3px;
                            border-radius: 4px;
                            border-color: #0288d1;
                        }
                        if (is_InputConnector): InputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: item.label == "" ? item.name : item.label;
                            port_clicked(is_input, port_name) => {
                                root.handle_port_click(i, is_input, item.creation_mode, port_name);
                            }
                        }
                        if (is_OutConnector): OutputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: item.label == "" ? item.name : item.label;
                            port_clicked(is_input, port_name) => {
                                root.handle_port_click(i, is_input, item.creation_mode, port_name);
                            }
                        }
                        if (!is_connector): NodeSymbol {
                            width: 100%;
                            height: 100%;
                            label: item.label == "" ? item.name : item.label;
                            creation_mode: item.creation_mode;
                            port_clicked(is_input, port_name) => {
                                let final_is_input = (!is_input && (port_name == "left" || port_name == "top")) ? true : is_input;
                                debug("Port Clicked - Name:", port_name, "| Is Input:", final_is_input);
                                root.handle_port_click(i, final_is_input, item.creation_mode, port_name);
                            }
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;

                            property <bool> shift-is-pressed: false;

                            pointer-event(evt) => {
                                shift-is-pressed = evt.modifiers.shift;

                                if (evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down) {
                                    if (!item.is_selected) {
                                        root.selected_index = i;
                                        root.node_clicked(i, evt.modifiers.shift);
                                    }
                                    root.backup_selected_indexes = root.selected_indexes;
                                    active_node_index = i;

                                    menu_x = self.mouse-x + (item.x * 1px - 60px) + root.canvas_pan_x + 260px;
                                    menu_y = self.mouse-y + (item.y * 1px) + root.canvas_pan_y;

                                    menu_visible = true;
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }

                            clicked => {
                                root.selected_index = i;
                                root.node_clicked(i, shift-is-pressed);
                                menu_visible = false;
                            }
                            double-clicked => {
                                root.node_clicked(i, false);
                                root.prevent_placement = true;
                                root.editing_index = i;
                                root.edit_label = item.label;
                                root.edit_value = item.value;
                                root.show_node_modal = true;
                            }
                            moved => {
                                root.update_symbol_position(i, (self.mouse-x + parent.x + 60px) / 1px, (self.mouse-y + parent.y + 20px) / 1px);
                            }
                        }
                    }

                    if (root.is_pasting_mode): Rectangle {

                        for ghost in root.ghost_symbols: Rectangle {
                            property <bool> is_InputConnector: ghost.node_type == "ip_connector";
                            property <bool> is_OutputConnector: ghost.node_type == "op_connector";
                            property <bool> is_connector: is_InputConnector || is_OutputConnector;
                            width: is_connector ? 60px : 120px;
                            height: 40px;
                            x: root.live_mouse_x + (ghost.x * 1px);
                            y: root.live_mouse_y + (ghost.y * 1px);
                            background: #0d6efd.with_alpha(25%);
                            border-color: #0d6efd;
                            border-width: 2px;
                            border-radius: 4px;
                            if (is_InputConnector): InputConnectorSymbol {
                                width: parent.width;
                                height: parent.height;
                                label: ghost.label;
                            }
                            if (is_OutputConnector): OutputConnectorSymbol {
                                width: parent.width;
                                height: parent.height;
                                label: ghost.label;
                            }
                            if (!is_connector): NodeSymbol {
                                width: parent.width;
                                height: parent.height;
                                label: ghost.label;
                                creation_mode: ghost.creation_mode;
                            }
                        }
                    }
                    for conn[index] in root.connections: Rectangle {

                        property <bool> isOutputConnector: root.all_symbols[conn.from_index].node_type == "op_connector";
                        property <bool> isInputConnector: root.all_symbols[conn.to_index].node_type == "ip_connector";
                        property <float> from_hw: isOutputConnector ? 0 : 60;
                        property <float> to_hw: isInputConnector ? 60 : 60;
                        property <float> sx: (conn.from_port == "right") ? (root.all_symbols[conn.from_index].x + from_hw) : (conn.from_port == "left") ? (root.all_symbols[conn.from_index].x - from_hw) : (root.all_symbols[conn.from_index].x);
                        property <float> sy: (conn.from_port == "right" || conn.from_port == "left") ? (root.all_symbols[conn.from_index].y) : (conn.from_port == "bottom") ? (root.all_symbols[conn.from_index].y + 20) : (root.all_symbols[conn.from_index].y - 20);
                        property <float> tx: (conn.to_port == "right") ? (root.all_symbols[conn.to_index].x + to_hw) : (conn.to_port == "left") ? (root.all_symbols[conn.to_index].x - to_hw) : (root.all_symbols[conn.to_index].x);
                        property <float> ty: (conn.to_port == "right" || conn.to_port == "left") ? (root.all_symbols[conn.to_index].y) : (conn.to_port == "bottom") ? (root.all_symbols[conn.to_index].y + 20) : (root.all_symbols[conn.to_index].y - 20);

                        property <float> left: Math.min(sx, tx);
                        property <float> top: Math.min(sy, ty);
                        property <float> pad: 40;

                        property <bool> is_target_above: ty < sy;

                        property <float> pw: Math.max(Math.abs(tx - sx), 1) + (pad * 2);
                        property <float> ph: (Math.max(Math.abs(ty - sy), 1) + (pad * 2)) + (is_target_above ? 40 : 0);

                        x: (left - pad) * 1px + root.canvas_pan_x;
                        y: (top - pad) * 1px + root.canvas_pan_y;
                        width: pw * 1px;
                        height: ph * 1px;
                        background: transparent;
                        z: 1;

                        Rectangle {
                            property <float> local_sx: sx - left + pad;
                            property <float> local_sy: sy - top + pad;
                            property <float> local_tx: tx - left + pad;
                            property <float> local_ty: ty - top + pad;

                            property <float> center_offset: -2;
                            property <float> adjusted_sy: local_sy + center_offset + 2;

                            property <bool> is_target_above: ty < sy;
                            property <bool> is_target_left: tx < sx;
                            property <bool> is_straight_vertical: Math.abs(local_sx - local_tx) < 2;

                            property <float> wp_x1: is_straight_vertical ? local_tx : (local_sx + 25);

                            property <float> wp_y1: is_straight_vertical ? local_ty : (is_target_left ? (is_target_above ? (local_ty - 30) : (local_sy + 40)) : (is_target_above ? (local_ty - 30) : (adjusted_sy + (local_ty - adjusted_sy) / 2)));

                            property <float> wp_x2: local_tx + 1;
                            property <float> thick: 16.0;

                            Path {
                                visible: (conn.from_port == "right" && conn.to_port == "top");
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: pw;
                                viewbox-height: ph;
                                fill: transparent;
                                stroke: orange;
                                stroke-width: conn.selected ? 3px : 2px;

                                MoveTo {
                                    x: local_sx;
                                    y: adjusted_sy;
                                }

                                LineTo {
                                    x: wp_x1;
                                    y: adjusted_sy;
                                }

                                LineTo {
                                    x: wp_x1;
                                    y: wp_y1;
                                }

                                LineTo {
                                    x: wp_x2;
                                    y: wp_y1;
                                }

                                LineTo {
                                    x: wp_x2;
                                    y: local_ty;
                                }
                            }

                            if (conn.from_port == "right" && conn.to_port == "top"): Rectangle {
                                background: transparent;

                                Rectangle {
                                    x: Math.min(local_sx, wp_x1) * 1px;
                                    y: adjusted_sy * 1px - (thick / 2) * 1px;
                                    width: (Math.abs(wp_x1 - local_sx) + 1.0) * 1px;
                                    height: thick * 1px;
                                    background: transparent;
                                    TouchArea {
                                        pointer-event(evt) => {
                                            if (evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down) {
                                                root.select_connection(index);
                                                root.selected_index = -1;
                                                active_node_index = index;

                                                menu_x = self.mouse-x + parent.x + left * 1px - pad * 1px + root.canvas_pan_x + 260px;
                                                menu_y = self.mouse-y + parent.y + top * 1px - pad * 1px + root.canvas_pan_y;

                                                menu_visible = true;
                                                return EventResult.accept;
                                            }
                                            return EventResult.reject;
                                        }
                                        clicked => {
                                            root.select_connection(index);
                                            root.selected_index = -1;
                                            menu_visible = false;
                                        }
                                    }
                                }

                                Rectangle {
                                    x: wp_x1 * 1px - (thick / 2) * 1px;
                                    y: Math.min(adjusted_sy, wp_y1) * 1px;
                                    width: thick * 1px;
                                    height: (Math.abs(wp_y1 - adjusted_sy) + 1.0) * 1px;
                                    background: transparent;
                                    TouchArea {
                                        pointer-event(evt) => {
                                            if (evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down) {
                                                root.select_connection(index);
                                                root.selected_index = -1;
                                                active_node_index = index;

                                                menu_x = self.mouse-x + parent.x + left * 1px - pad * 1px + root.canvas_pan_x + 260px;
                                                menu_y = self.mouse-y + parent.y + top * 1px - pad * 1px + root.canvas_pan_y;

                                                menu_visible = true;
                                                return EventResult.accept;
                                            }
                                            return EventResult.reject;
                                        }
                                        clicked => {
                                            root.select_connection(index);
                                            root.selected_index = -1;
                                            menu_visible = false;
                                        }
                                    }
                                }

                                Rectangle {
                                    x: Math.min(wp_x1, wp_x2) * 1px;
                                    y: wp_y1 * 1px - (thick / 2) * 1px;
                                    width: (Math.abs(wp_x2 - wp_x1) + 1.0) * 1px;
                                    height: thick * 1px;
                                    background: transparent;
                                    TouchArea {
                                        pointer-event(evt) => {
                                            if (evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down) {
                                                root.select_connection(index);
                                                root.selected_index = -1;
                                                active_node_index = index;

                                                menu_x = self.mouse-x + parent.x + left * 1px - pad * 1px + root.canvas_pan_x + 260px;
                                                menu_y = self.mouse-y + parent.y + top * 1px - pad * 1px + root.canvas_pan_y;

                                                menu_visible = true;
                                                return EventResult.accept;
                                            }
                                            return EventResult.reject;
                                        }
                                        clicked => {
                                            root.select_connection(index);
                                            root.selected_index = -1;
                                            menu_visible = false;
                                        }
                                    }
                                }

                                Rectangle {
                                    x: wp_x2 * 1px - (thick / 2) * 1px;
                                    y: Math.min(wp_y1, local_ty) * 1px;
                                    width: thick * 1px;
                                    height: (Math.abs(local_ty - wp_y1) + 1.0) * 1px;
                                    background: transparent;
                                    TouchArea {
                                        pointer-event(evt) => {
                                            if (evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down) {
                                                root.select_connection(index);
                                                root.selected_index = -1;
                                                active_node_index = index;

                                                menu_x = self.mouse-x + parent.x + left * 1px - pad * 1px + root.canvas_pan_x + 260px;
                                                menu_y = self.mouse-y + parent.y + top * 1px - pad * 1px + root.canvas_pan_y;

                                                menu_visible = true;
                                                return EventResult.accept;
                                            }
                                            return EventResult.reject;
                                        }
                                        clicked => {
                                            root.select_connection(index);
                                            root.selected_index = -1;
                                            menu_visible = false;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {

                            property <bool> is_forward: tx >= sx;
                            property <float> local_sx: (sx - left + pad) + 1;
                            property <float> local_sy: sy - top + pad;
                            property <float> local_tx: tx - left + pad;
                            property <float> local_ty: ty - top + pad - 2;
                            property <float> center_offset: -2;
                            property <float> adjusted_sy: local_sy + center_offset;
                            property <float> adjusted_ty: local_ty + center_offset + 2;

                            property <bool> is_straight_line: Math.abs(local_sx - local_tx) < 2;

                            property <float> wp_y1: is_straight_line ? adjusted_ty : (local_sy + 40);
                            property <float> wp_x: is_straight_line ? local_tx : (local_tx - 40);
                            property <float> target_y: is_straight_line ? adjusted_ty : (adjusted_ty + 1);

                            property <float> thick: 16.0;

                            Path {
                                visible: (conn.from_port == "bottom" && conn.to_port == "left");
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: pw;
                                viewbox-height: ph;
                                fill: transparent;
                                stroke: orange;
                                stroke-width: conn.selected ? 3px : 2px;

                                MoveTo {
                                    x: local_sx;
                                    y: local_sy;
                                }

                                LineTo {
                                    x: local_sx;
