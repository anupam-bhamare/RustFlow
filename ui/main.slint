import { Button, LineEdit, ComboBox, ScrollView } from "std-widgets.slint";

export struct SymbolEntry {
    id: int,
    name: string,
    label: string,
    value: string,
    x: float,
    y: float,
    node_type: string,
    bg_color: string,
    creation_mode: int,
    is_selected: bool,
    ip_ports: int,
    op_ports: int,
    ip_names: [string],
    ip_values: [string],
    op_names: [string],
    op_values: [string],
    ip_types: [string],
    op_types: [string],
}

export struct Connection {
    from_index: int,
    to_index: int,
    selected: bool,
    creation_mode: int,
    from_port: string,
    to_port: string,
    from_port_offset_x: float,
    from_port_offset_y: float,
    to_port_offset_x: float,
    to_port_offset_y: float,
}

struct LibraryItem {
    name: string,
    node_type: string,
}
component NodeSymbol inherits Rectangle {
    callback port_clicked(bool, string);

    in property <string> label: "Data Sorter";
    in property <string> value: "Active";
    in property <int> ip_ports: 2;
    in property <int> op_ports: 2;

    property <length> row_height: 35px;
    property <length> port_size: 10px;
    property <length> header_height: 40px;

    in property <[string]> ip_names;
    in property <[string]> ip_values;
    in property <[string]> op_names;
    in property <[string]> op_values;
    in property <[string]> ip_types;
    in property <[string]> op_types;
    in property <int> creation_mode: 0;
    width: 140px;
    height: header_height + ((ip_ports + op_ports) * row_height);
    background: #e1f5fe.with-alpha(0.5);
    border-width: 1px;
    border-color: #0288d1;
    border-radius: 4px;
    clip: false;

    VerticalLayout {
        y: 2px;
        height: header_height;
        Text {
            text: root.label;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.value;
            font-italic: true;
            horizontal-alignment: center;
        }

        Rectangle {

            width: parent.width;
            height: 0.5px;
            background: #0288d1.with-alpha(0.5);
        }
    }

    for port[i] in root.ip_ports: Rectangle {
        y: header_height + (i * row_height);
        width: parent.width;
        height: row_height;

        Rectangle {
            x: -port_size / 2;
            y: (parent.height - self.height) / 2;
            width: port_size;
            height: port_size;
            border-radius: port_size / 2;
            background: left_touch.has-hover ? orange : #0288d1;
        }

        HorizontalLayout {
            padding-left: port_size;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.ip_names[i];
                    overflow: elide;
                }

                Text {
                    text: root.ip_values[i];
                    overflow: elide;
                    color: gray;
                }
            }
        }

        Rectangle {
            y: row_height;
            width: parent.width - port_size;
            height: 0.5px;
            background: #0288d1.with-alpha(0.5);
        }

        left_touch := TouchArea {
            x: -port_size;
            width: parent.width + port_size;
            pointer-event(evt) => {
                if (evt.kind == PointerEventKind.down) {
                    root.port_clicked(true, "left_" + i);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }
    }

    for port[i] in root.op_ports: Rectangle {
        y: header_height + (root.ip_ports * row_height) + (i * row_height);
        width: parent.width;
        height: row_height;

        Rectangle {
            x: parent.width - port_size / 2;
            y: (parent.height - self.height) / 2;
            width: port_size;
            height: port_size;
            border-radius: port_size / 2;
            background: right_touch.has-hover ? orange : #0288d1;
        }

        HorizontalLayout {
            padding-right: port_size;
            alignment: end;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.op_names[i];
                    overflow: elide;
                    horizontal-alignment: right;
                }

                Text {
                    text: root.op_values[i];
                    overflow: elide;
                    color: gray;
                    horizontal-alignment: right;
                }
            }
        }

        Rectangle {
            y: row_height;
            width: parent.width - port_size;
            height: 0.5px;
            background: #0288d1.with-alpha(0.5);
        }

        right_touch := TouchArea {
            x: 0;
            width: parent.width + port_size;
            pointer-event(evt) => {
                if (evt.kind == PointerEventKind.down) {
                    root.port_clicked(false, "right_" + i);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }
    }
}


component InputConnectorSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode: 0;

    width: 60px;
    height: 40px;
    background: #bae2b1.with-alpha(0.5);
    border-width: 1px;
    border-color: #8ba47c;
    border-radius: 4px;

    Rectangle {
        x: -5px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: input_touch.has-hover ? orange : #8ba47c;
        input_touch := TouchArea {
            clicked => {
                root.port_clicked(true, "left");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component OutputConnectorSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode: 0;

    width: 60px;
    height: 40px;
    background: #bae2b1.with-alpha(0.5);
    border-width: 1px;
    border-color: #8ba47c;
    border-radius: 4px;

    Rectangle {
        x: 55px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: output_touch.has-hover ? orange : #8ba47c;
        output_touch := TouchArea {
            clicked => {
                root.port_clicked(false,"right");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {

    preferred-width: 1280px;
    preferred-height: 720px;

    min-width: 400px;
    min-height: 400px;
    in-out property <[string]> ip_names: [];
    in-out property <[string]> ip_values: [];
    in-out property <[string]> op_names: [];
    in-out property <[string]> op_values: [];
    in-out property <[string]> ip_types: [];
    in-out property <[string]> op_types: [];
    pure function is_valid(type: string, val: string) -> bool {
        if (type == "Number") {

            if (val == "") { return false; }
            return true;
        }
        return true;
    }

    callback add_ip_port();
    callback add_op_port();
    callback request_edit_node(int);
    in-out property <int> ip_port_count;
    in-out property <int> op_port_count;
    in-out property <int> port_count;
    in-out property <[string]> edit_values;
    in-out property <string> temp_ip_ports: "";
    in-out property <string> temp_op_ports: "";
    in-out property <int> function_node_ip_ports: 0;
    in-out property <int> function_node_op_ports: 0;
    in-out property <int> ip_ports: 0;
    in-out property <int> op_ports: 0;

    callback deploy_flow_clicked();
    in-out property <string> debug_text: "";
    property <bool> common_expanded: false;
    property <bool> function_expanded: false;
    property <bool> parser_expanded: false;
    property <bool> storage_expanded: false;
    property <bool> dashboard_expanded: false;
    property <bool> network_expanded: false;
    property <bool> actions_expanded: false;
    property <bool> layout_expanded: false;
    property <bool> connectors_expanded: false;
    property <bool> prevent_placement: false;
    property <[int]> backup_selected_indexes: [];
    property <length> menu_x: 0px;
    property <length> menu_y: 0px;
    property <bool> menu_visible: false;
    property <int> active_node_index: -1;
    property <float> pan_start_x: 0;
    property <float> pan_start_y: 0;
    in-out property <[SymbolEntry]> nodes: [];
    in-out property <int> selected_node_index: -1;
    in-out property <[int]> selected_indexes: [];
    in-out property <[SymbolEntry]> all_symbols: [];
    in-out property <[Connection]> connections: [];
    in-out property <[SymbolEntry]> ghost_symbols: [];
    in-out property <[Connection]> ghost_connections: [];
    in-out property <bool> is_pasting_mode: false;
    in-out property <length> live_mouse_x: 0px;
    in-out property <length> live_mouse_y: 0px;
    in-out property <length> canvas_pan_x: 0px;
    in-out property <length> canvas_pan_y: 0px;
    in-out property <int> active_layout_mode: 0;
    in-out property <bool> show_alert: false;
    in-out property <string> alert_message: "";
    in-out property <bool> is_dragging: false;
    in-out property <string> drag_name: "";
    in-out property <int> creation_mode: 0;
    in-out property <string> drag_type: "";
    in-out property <string> bg_color: "";
    in-out property <float> drag_x: 0;
    in-out property <float> drag_y: 0;
    in-out property <bool> show_node_modal: false;
    in-out property <bool> show_port_configuration_modal: false;
    in-out property <string> edit_label: "";
    in-out property <string> edit_value: "";
    in-out property <int> editing_index: -1;
    in-out property <int> selected_index: -1;
    in-out property <string> active_selection_mode: "";

    callback delete_selected_symbols([int]);
    callback select_all();
    callback cut_nodes();
    callback copy_selected_subgraph([int]);
    callback paste_selected_subgraph(float, float);
    callback cut_selected_subgraph([int]);
    callback node_clicked(int, bool);
    callback canvas_clicked();
    callback copy_node(int);
    callback cut_node(int);
    callback undo_action();
    callback redo_action();
    callback vertical_layout();
    callback horizontal_layout();
    callback save_node_properties(int, int, int, string, [string], [string], [string], [string], [string], [string]) -> bool;
    callback select_library_symbol(string);
    callback place_symbol(string, string, string, float, float, int, int, int);
    callback update_symbol_position(int, float, float);
    callback delete_selected_symbol();
    callback clear_canvas();
    callback import_xml();
    callback handle_port_click(int, bool, int, string);
    callback select_connection(int);
    callback delete_selected_connection();
    callback save_flow();
    callback load_flow();

    public function trigger_alert(msg: string) {
        root.alert_message = msg;
        root.show_alert = true;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        HorizontalLayout {
            width: 100%;
            height: 100%;

            Rectangle {
                width: 260px;
                background: #f7f7f7;
                border-width: 1px;
                border-color: #dcdcdc;

                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;

                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: sidebar-content.min-height;
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                menu_visible = false;
                            }
                        }

                        sidebar-content := VerticalLayout {
                            alignment: start;
                            spacing: 10px;

                            Rectangle {
                                height: 36px;
                                background: item1_touch.has-hover ? rgb(146, 167, 187) : rgb(166, 187, 207);
                                border-radius: 4px;

                                Text {
                                    text: (root.common_expanded ? "▼ " : "▶ ") + "Common";
                                    color: white;
                                    font-weight: 700;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                item1_touch := TouchArea {
                                    clicked => {
                                        let was_open = root.common_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.common_expanded = !was_open;
                                        menu_visible = false;
                                    }
                                }
                            }

                            if (root.common_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in [
                                    { name: "Text", node_type: "ui_text" },
                                    { name: "Button", node_type: "ui_button" },
                                    { name: "Dropdown", node_type: "ui_dropdown" },
                                    { name: "Output", node_type: "ui_output" },
                                    { name: "Error", node_type: "ui_error" }
                                ]: Rectangle {
                                    height: 35px;
                                    background: common-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node.name;
                                        color: black;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    common-touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node.name;
                                            root.drag_type = node.node_type;
                                            root.select_library_symbol(node.name);

                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                            root.ip_ports = root.function_node_ip_ports;
                                            root.op_ports = root.function_node_op_ports;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: item2_touch.has-hover ? rgb(233, 188, 142) : rgb(253, 208, 162);
                                border-radius: 4px;

                                Text {
                                    text: (root.function_expanded ? "▼ " : "▶ ") + "Function";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                item2_touch := TouchArea {
                                    clicked => {
                                        let was_open = root.function_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
