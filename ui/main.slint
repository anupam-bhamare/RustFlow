                            if (root.network_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["MQTT", "HTTP", "TCP"]: Rectangle {
                                    height: 35px;
                                    background: network-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }
                                    Text {
                                        text: node;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    network_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node;
                                            root.select_library_symbol(node);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: rose_touch.has-hover ? #ddc1c1 : #edd1d1;
                                border-radius: 4px;
                                Text {
                                    text: (root.actions_expanded ? "▼ " : "▶ ") + "Actions";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                rose_touch := TouchArea {
                                    clicked => {
                                        let was_open = root.actions_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.actions_expanded = !was_open;
                                        menu_visible = false;
                                    }
                                }
                            }

                            if (root.actions_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Delete Node", "Delete Wire", "Clear All", "Save Flow", "Load Flow"]: Rectangle {
                                    height: 35px;
                                    background: actions-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    actions-touch := TouchArea {
                                        clicked => {
                                            if (node == "Delete Wire") {
                                                root.delete_selected_connection();
                                            } else if (node == "Delete Node") {
                                                root.delete_selected_symbol();
                                            } else if (node == "Save Flow") {
                                                root.save_flow();
                                            } else if (node == "Load Flow") {
                                                root.load_flow();
                                            } else if (node == "Clear All") {
                                                root.clear_canvas();
                                            } else {
                                                root.is_dragging = true;
                                                root.drag_name = node;
                                                root.select_library_symbol(node);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: blue_touch.has-hover ? #1c5cd1 : #6597f4;
                                border-radius: 4px;
                                Text {
                                    text: (root.layout_expanded ? "▼ " : "▶ ") + "Layout";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                blue_touch := TouchArea {
                                    clicked => {
                                        let was_open = root.layout_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = false;
                                        root.layout_expanded = !was_open;
                                        menu_visible = false;
                                    }
                                }
                            }

                            if (root.layout_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in ["Horizontal", "Vertical", "Port Configuration"]: Rectangle {
                                    height: 35px;
                                    background: layout-touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    layout-touch := TouchArea {
                                        clicked => {
                                            if (node == "Horizontal") {
                                                root.active_layout_mode = 0;
                                                root.horizontal_layout();
                                            } else if (node == "Vertical") {
                                                root.active_layout_mode = 1;
                                                root.vertical_layout();
                                            } else if (node == "Port Configuration") {
                                                root.show_port_configuration_modal = true;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: green_touch.has-hover ? #abdba2 : #bbebb2;
                                border-radius: 4px;
                                Text {
                                    text: (root.connectors_expanded ? "▼ " : "▶ ") + "Connectors";
                                    color: white;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                green_touch := TouchArea {
                                    clicked => {
                                        let was_open = root.connectors_expanded;
                                        root.common_expanded = false;
                                        root.function_expanded = false;
                                        root.network_expanded = false;
                                        root.actions_expanded = false;
                                        root.dashboard_expanded = false;
                                        root.storage_expanded = false;
                                        root.parser_expanded = false;
                                        root.layout_expanded = false;
                                        root.connectors_expanded = !was_open;
                                        menu_visible = false;
                                    }
                                }
                            }

                            if (root.connectors_expanded): VerticalLayout {
                                spacing: 6px;
                                for node in [{ name: "A", node_type: "ip_connector" }, { name: "B", node_type: "op_connector" }]: Rectangle {
                                    height: 35px;
                                    background: connectors_touch.has-hover ? #e2dfed : #edebf4;
                                    border-radius: 4px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: node.name;
                                        color: #222;
                                        x: 10px;
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }

                                    connectors_touch := TouchArea {
                                        moved => {
                                            root.is_dragging = true;
                                            root.drag_name = node.name;
                                            root.drag_type = node.node_type;
                                            root.select_library_symbol(node.name);
                                            root.drag_x = (self.mouse-x + self.absolute-position.x - 260px) / 1px;
                                            root.drag_y = (self.mouse-y + self.absolute-position.y) / 1px;
                                            root.creation_mode = root.active_layout_mode;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 5px;

                        Rectangle {

                            height: 40px;
                            vertical-stretch: 0;
                            HorizontalLayout {
                                spacing: 10px;

                                Rectangle {
                                    background: #e06c75;
                                    border-radius: 4px;
                                    Button {
                                        text: "Del ";
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            menu_visible = false;
                                            if (root.active_selection_mode == "connection") {
                                                root.delete_selected_connection();
                                            } else if (root.active_selection_mode == "node" || root.backup_selected_indexes.length > 0) {
                                                root.delete_selected_symbols(root.backup_selected_indexes);
                                            }
                                            root.selected_indexes = [];
                                            root.backup_selected_indexes = [];
                                            root.active_selection_mode = "";
                                            root.select_connection(-1);
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #d19a66;
                                    border-radius: 4px;
                                    Button {
                                        text: "Clr ";
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            menu_visible = false;
                                            root.clear_canvas();
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #61afef;
                                    border-radius: 4px;
                                    Button {
                                        text: "Save";
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            menu_visible = false;
                                            root.save_flow();
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #98c379;
                                    border-radius: 4px;
                                    Button {
                                        text: "Load";
                                        width: 100%;
                                        height: 100%;
                                        clicked => {
                                            menu_visible = false;
                                            root.load_flow();
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {

                            height: 40px;
                            vertical-stretch: 0;

                            Rectangle {
                                background: #2432b7;
                                border-radius: 4px;
                                Button {
                                    text: "Deploy Flow";
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        menu_visible = false;

                                        root.deploy_flow_clicked();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: #f8f5f5;
                clip: true;

                for i in 250: Rectangle {
                    x: (i * 15) * 1px;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: #e0e0e0;
                }

                for i in 150: Rectangle {
                    x: 0;
                    y: (i * 15) * 1px;
                    width: parent.width;
                    height: 1px;
                    background: #e0e0e0;
                }
                ForwardFocus := FocusScope {
                    width: 100%;
                    height: 100%;

                    key-pressed(event) => {
                        let is_modifier_pressed = event.modifiers.control || event.modifiers.meta;
                        if (is_modifier_pressed) {
                            if (event.text == "c") {
                                root.copy_selected_subgraph(root.backup_selected_indexes);
                                return EventResult.accept;
                            }
                            if (event.text == "x") {
                                root.cut_selected_subgraph(root.backup_selected_indexes);
                                accept;
                            }
                            if (event.text == "a") {
                                root.select_all();
                                root.backup_selected_indexes = root.selected_indexes;
                                return EventResult.accept;
                            }
                            if (event.text == "v") {
                                root.paste_selected_subgraph(    (-root.canvas_pan_x / 1px) + 300,     (-root.canvas_pan_y / 1px) + 200);

                                return EventResult.accept;
                            }
                            EventResult.reject;
                        }
                        if (event.text == "z" && event.modifiers.control) {
                            root.undo_action();
                            accept;
                        }
                        if (event.text == "y" && event.modifiers.control) {
                            root.redo_action();
                            accept;
                        }
                        if (event.text == "d" && event.modifiers.control) {
                            if (root.active_selection_mode == "connection") {
                                root.delete_selected_connection();
                            } else if (root.active_selection_mode == "node" || root.backup_selected_indexes.length > 0) {
                                root.delete_selected_symbols(root.backup_selected_indexes);
                            }
                            root.selected_indexes = [];
                            root.backup_selected_indexes = [];
                            root.active_selection_mode = "";
                            root.select_connection(-1);
                            return EventResult.accept;
                        }
                        if (root.selected_index != -1) {
                            let delta: float = event.modifiers.shift ? 1.0 : 2.0;

                            if (event.text == Key.LeftArrow) {
                                root.update_symbol_position(root.selected_index, (root.all_symbols[root.selected_index].x - delta), root.all_symbols[root.selected_index].y);
                                accept;
                            }
                            if (event.text == Key.RightArrow) {
                                root.update_symbol_position(root.selected_index, (root.all_symbols[root.selected_index].x + delta), root.all_symbols[root.selected_index].y);
                                accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.update_symbol_position(root.selected_index, root.all_symbols[root.selected_index].x, (root.all_symbols[root.selected_index].y - delta));
                                accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.update_symbol_position(root.selected_index, root.all_symbols[root.selected_index].x, (root.all_symbols[root.selected_index].y + delta));
                                accept;
                            }
                        }
                        reject;
                    }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;

                    property <physical-length> right_click_press_x: 0;
                    property <physical-length> right_click_press_y: 0;

                    pointer-event(event) => {

                        if (event.kind == PointerEventKind.move) {
                            root.live_mouse_x = self.mouse-x;
                            root.live_mouse_y = self.mouse-y;
                        }
                        return EventResult.reject;
                    }

                    moved => {
                        if (root.is_dragging) {
                            root.drag_x = self.mouse-x / 1px;
                            root.drag_y = self.mouse-y / 1px;
                        }
                    }

                    clicked => {

                        menu_visible = false;
                        root.selected_index = -1;
                        root.select_connection(-1);
                        ForwardFocus.focus();
                        root.selected_indexes = [];

                        if (root.is_dragging) {

                            let is_connector = root.drag_name == "A" || root.drag_name == "B";
                            let shape_w = is_connector ? 60 : 140;
                            let shape_h = is_connector ? 40 : 40;
                            let drop_x = root.drag_x;
                            let drop_y = root.drag_y;

                            root.place_symbol(root.drag_name, root.drag_type, "#0d6efd", drop_x, drop_y, root.active_layout_mode, root.function_node_ip_ports, root.function_node_op_ports);
                            root.is_dragging = false;
                        } else if (root.selected_index != -1) {
                            root.selected_index = -1;
                        }
                    }

                    if (root.is_dragging): Rectangle {
                        property <bool> is_connector: root.drag_name == "A" || root.drag_name == "B";
                        property <bool> is_InputConnector: root.drag_type == "ip_connector";
                        property <bool> is_OutConnector: root.drag_type == "op_connector";
                        width: is_connector ? 60px : 140px;
                        height: is_connector ? 40px : 40px + (root.function_node_ip_ports + root.function_node_op_ports) * 35px;

                        x: root.drag_x * 1px - (self.width / 2);
                        y: root.drag_y * 1px - (self.height / 2);
                        opacity: 0.5;

                        if (is_InputConnector): InputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: root.drag_name;
                            creation_mode: root.active_layout_mode;
                        }
                        if (is_OutConnector): OutputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: root.drag_name;
                            creation_mode: root.active_layout_mode;
                        }
                        if (!is_InputConnector && !is_OutConnector): NodeSymbol {
                            width: 100%;
                            height: 100%;
                            label: root.drag_name;
                            creation_mode: root.active_layout_mode;
                            ip_ports: root.function_node_ip_ports;
                            op_ports: root.function_node_op_ports;
                        }
                    }
                    for item[i] in root.all_symbols: Rectangle {
                        z: 2;
                        property <bool> is_InputConnector: item.node_type == "ip_connector";
                        property <bool> is_OutConnector: item.node_type == "op_connector";
                        property <bool> is_connector: is_InputConnector || is_OutConnector;
                        width: is_connector ? 60px : 140px;
                        height: is_connector ? 40px : 40px + (item.ip_ports + item.op_ports) * 35px;

                        x: item.x * 1px;
                        y: item.y * 1px;

                        property <bool> node-is-selected: item.is_selected;

                        if (node-is-selected && (root.selected_index == i || root.selected_indexes.length > 1)): Rectangle {
                            border-width: 3px;
                            border-radius: 4px;
                            border-color: #0288d1;
                        }
                        if (is_InputConnector): InputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: item.label == "" ? item.name : item.label;
                            port_clicked(is_input, port_name) => {
                                root.handle_port_click(i, is_input, item.creation_mode, port_name);
                            }
                        }
                        if (is_OutConnector): OutputConnectorSymbol {
                            width: 100%;
                            height: 100%;
                            label: item.label == "" ? item.name : item.label;
                            port_clicked(is_input, port_name) => {
                                root.handle_port_click(i, is_input, item.creation_mode, port_name);
                            }
                        }
                        if (!is_connector): NodeSymbol {
                            ip_names: item.ip_names;
                            op_names: item.op_names;
                            ip_values: item.ip_values;
                            op_values: item.op_values;
                            ip_ports: item.ip_ports;
                            op_ports: item.op_ports;
                            ip_types: item.ip_types;
                            op_types: item.op_types;
                            width: 100%;
                            height: 100%;
                            label: item.label == "" ? item.name : item.label;
                            value: item.value;
                            creation_mode: item.creation_mode;

                            port_clicked(is_input, port_name) => {
                                let final_is_input = (!is_input && (port_name == "left" || port_name == "top")) ? true : is_input;
                                debug("Port Clicked - Name:", port_name, "| Is Input:", final_is_input);
                                root.handle_port_click(i, final_is_input, item.creation_mode, port_name);
                            }
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;

                            property <bool> control-is-pressed: false;

                            pointer-event(evt) => {
                                control-is-pressed = evt.modifiers.control;

                                if (evt.button == PointerEventButton.right && evt.kind == PointerEventKind.down) {
                                    if (!item.is_selected) {
                                        root.selected_index = i;
                                        root.node_clicked(i, evt.modifiers.control);
                                        root.active_selection_mode = "node";
                                    }
                                    root.backup_selected_indexes = root.selected_indexes;
                                    active_node_index = i;

                                    menu_x = self.mouse-x + (item.x * 1px - 60px) + root.canvas_pan_x + 260px;
                                    menu_y = self.mouse-y + (item.y * 1px) + root.canvas_pan_y;

                                    menu_visible = true;
                                    return EventResult.accept;
                                }
                                return EventResult.reject;
                            }

                            clicked => {

                                root.select_connection(-1);
                                root.selected_index = i;
                                root.node_clicked(i, control-is-pressed);
                                root.active_selection_mode = "node";
                                root.backup_selected_indexes = root.selected_indexes;
                                menu_visible = false;
                            }
                            double-clicked => {
                                root.node_clicked(i, false);
                                root.prevent_placement = true;
                                root.editing_index = i;
                                root.request_edit_node(root.editing_index);
                                root.edit_label = item.label;
                                root.edit_value = item.value;
                                root.show_node_modal = true;
                            }
                            moved => {
                                root.update_symbol_position(i, (self.mouse-x + parent.x + 60px) / 1px, (self.mouse-y + parent.y + 20px) / 1px);
                            }
                        }
                    }
                }

                for conn[index] in root.connections: Rectangle {

                    property <float> node_w: 140;
                    property <float> node_h: 40;
                    property <float> port_spacing: 24;

                    property <float> from_half_w: (root.all_symbols[conn.from_index].node_type == "ip_connector" || root.all_symbols[conn.from_index].node_type == "op_connector") ? 30 : 70;
                    property <float> sx: root.all_symbols[conn.from_index].x + conn.from_port_offset_x;
                    property <float> sy: root.all_symbols[conn.from_index].y + conn.from_port_offset_y;

                    property <float> tx: root.all_symbols[conn.to_index].x + conn.to_port_offset_x;
                    property <float> ty: root.all_symbols[conn.to_index].y + conn.to_port_offset_y;
                    property <float> left: Math.min(sx, tx);
                    property <float> top: Math.min(sy, ty);

                    property <float> pad: 60;

                    property <bool> is_target_above: ty < sy;

                    property <float> pw: Math.max(Math.abs(tx - sx), 140) + (pad * 2);
                    property <float> ph: Math.max(Math.abs(ty - sy), 80) + (pad * 2);

                    x: (left - pad) * 1px;
                    y: (top - pad) * 1px;
                    width: pw * 1px;
                    height: ph * 1px;
                    background: transparent;
                    z: 1;

                    Rectangle {
                        property <bool> is_forward: tx >= sx;
                        property <float> local_sx: (sx - left + pad);
                        property <float> local_sy: sy - top + pad;
                        property <float> local_tx: (tx - left + pad);
                        property <float> local_ty: ty - top + pad;
                        property <float> center_offset: -2;
                        property <float> adjusted_sy: local_sy + center_offset + 2;
                        property <float> adjusted_ty: local_ty + center_offset + 2;

                        property <bool> is_vertical_flow: (Math.abs(conn.from_port_offset_y) < 2.0 || Math.abs(conn.from_port_offset_y - 40.0) < 2.0) && (Math.abs(conn.to_port_offset_y) < 2.0 || Math.abs(conn.to_port_offset_y - 40.0) < 2.0);
                        property <bool> is_straight_line: is_vertical_flow ? (Math.abs(local_sx - local_tx) < 2) : (Math.abs(adjusted_sy - adjusted_ty) < 2);

                        property <float> mid_x: local_sx + (local_tx - local_sx) / 2;
                        property <float> mid_y: adjusted_sy + (adjusted_ty - adjusted_sy) / 2;

                        property <float> wp_x1: is_vertical_flow ? local_sx : (is_forward ? mid_x : (local_sx + 40));
                        property <float> wp_y: is_vertical_flow ? mid_y : (is_straight_line ? adjusted_sy : (is_forward ? adjusted_ty : mid_y));
                        property <float> wp_x2: is_vertical_flow ? local_tx : (is_forward ? mid_x : (local_tx - 40));

                        property <float> thick: 16.0;
                        property <float> seg45_y: is_straight_line ? adjusted_sy : adjusted_ty;

                        Path {
                            visible: conn.from_index != -1 && conn.to_index != -1;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: pw;
                            viewbox-height: ph;
                            fill: transparent;
                            stroke: orange;
                            stroke-width: conn.selected ? 3px : 2px;

                            MoveTo {
                                x: local_sx;
                                y: adjusted_sy;
                            }

                            LineTo {
                                x: is_vertical_flow ? local_sx : wp_x1;
                                y: is_vertical_flow ? mid_y : adjusted_sy;
                            }

                            LineTo {
                                x: is_vertical_flow ? local_tx : wp_x2;
                                y: is_vertical_flow ? mid_y : wp_y;
                            }

                            LineTo {
                                x: local_tx;
                                y: is_vertical_flow ? adjusted_ty : wp_y;
                            }

                            LineTo {
                                x: local_tx;
                                y: is_straight_line ? adjusted_sy : adjusted_ty;
                            }
                        }

                        init => {
                            debug("from offset x=" + conn.from_port_offset_x);
                            debug("from offset y=" + conn.from_port_offset_y);

                            debug("to offset x=" + conn.to_port_offset_x);
                            debug("to offset y=" + conn.to_port_offset_y);
                            debug("Node X = " + root.all_symbols[conn.from_index].x);
                            debug("Node Y = " + root.all_symbols[conn.from_index].y);

                            debug("SX = " + sx);
                            debug("SY = " + sy);
                            debug("Draw Node " + index);
                            debug("Parent X = " + self.x / 1px);
                            debug("Parent Y = " + self.y / 1px);
                        }

                        Rectangle {
                            x: Math.min(local_sx, wp_x1) * 1px;
                            y: (is_vertical_flow ? Math.min(adjusted_sy, mid_y) : adjusted_sy) * 1px - (thick / 2) * 1px;
                            width: (is_vertical_flow ? thick : (Math.abs(wp_x1 - local_sx) + 1.0)) * 1px;
                            height: (is_vertical_flow ? (Math.abs(mid_y - adjusted_sy) + 1.0) : thick) * 1px;
                            background: transparent;
                            TouchArea {
                                clicked => {
                                    root.active_selection_mode = "connection";
                                    root.select_connection(index);
                                    root.selected_index = -1;
                                    menu_visible = false;
                                }
                            }
                        }

                        Rectangle {
                            x: (is_vertical_flow ? Math.min(local_sx, local_tx) : wp_x1) * 1px - (is_vertical_flow ? 0px : (thick / 2) * 1px);
                            y: (is_vertical_flow ? mid_y : Math.min(adjusted_sy, wp_y)) * 1px - (is_vertical_flow ? (thick / 2) * 1px : 0px);
                            width: (is_vertical_flow ? (Math.abs(local_tx - local_sx) + 1.0) : thick) * 1px;
                            height: (is_vertical_flow ? thick : (Math.abs(wp_y - adjusted_sy) + 1.0)) * 1px;
                            background: transparent;
                            TouchArea {
                                clicked => {
                                    root.active_selection_mode = "connection";
                                    root.select_connection(index);
                                    root.selected_index = -1;
                                    menu_visible = false;
                                }
                            }
                        }

                        Rectangle {
                            x: (is_vertical_flow ? local_tx : Math.min(wp_x1, wp_x2)) * 1px - (thick / 2) * 1px;
                            y: (is_vertical_flow ? Math.min(mid_y, adjusted_ty) : wp_y) * 1px - (is_vertical_flow ? 0px : (thick / 2) * 1px);
                            width: (is_vertical_flow ? thick : (Math.abs(wp_x2 - wp_x1) + 1.0)) * 1px;
                            height: (is_vertical_flow ? (Math.abs(adjusted_ty - mid_y) + 1.0) : thick) * 1px;
                            background: transparent;
                            TouchArea {
                                clicked => {
                                    root.active_selection_mode = "connection";
                                    root.select_connection(index);
                                    root.selected_index = -1;
                                    menu_visible = false;
                                }
                            }
                        }

                        Rectangle {
                            visible: !is_vertical_flow;
                            x: wp_x2 * 1px - (thick / 2) * 1px;
                            y: Math.min(wp_y, seg45_y) * 1px;
                            width: thick * 1px;
                            height: (Math.abs(seg45_y - wp_y) + 1.0) * 1px;
                            background: transparent;
                            TouchArea {
                                clicked => {
                                    root.active_selection_mode = "connection";
                                    root.select_connection(index);
                                    root.selected_index = -1;
                                    menu_visible = false;
                                }
                            }
                        }

                        Rectangle {
                            visible: !is_vertical_flow;
                            x: Math.min(wp_x2, local_tx) * 1px;
                            y: seg45_y * 1px - (thick / 2) * 1px;
                            width: (Math.abs(local_tx - wp_x2) + 1.0) * 1px;
                            height: thick * 1px;
                            background: transparent;
                            TouchArea {
                                clicked => {
                                    root.active_selection_mode = "connection";
                                    root.select_connection(index);
                                    root.selected_index = -1;
                                    menu_visible = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if menu_visible: Rectangle {
        x: menu_x;
        y: menu_y;
        width: 160px;
        height: 210px;
        background: #ffffff;
        border-radius: 6px;
        border-width: 1px;
        border-color: #dcdcdc;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            Rectangle {
                background: copy-t.has-hover ? #f0f0f0 : transparent;
                height: 26px;
                border-radius: 4px;
                Text {
                    text: "Copy";
                    x: 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 13px;
                }

                Text {
                    text: "ctrl-c";
                    x: parent.width - self.width - 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 11px;
                    color: #888888;
                }

                copy-t := TouchArea {
                    clicked => {
                        root.copy_selected_subgraph(root.backup_selected_indexes);
                        menu_visible = false;
                    }
                }
            }

            Rectangle {
                background: paste-t.has-hover ? #f0f0f0 : transparent;
                height: 26px;
                border-radius: 4px;
                Text {
                    text: "Paste";
                    x: 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 13px;
                }

                Text {
                    text: "ctrl-v";
                    x: parent.width - self.width - 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 11px;
                    color: #888888;
                }

                paste-t := TouchArea {
                    clicked => {
                        menu_visible = false;

                        root.paste_selected_subgraph(    (-root.canvas_pan_x / 1px) + 300,     (-root.canvas_pan_y / 1px) + 200);
                    }
                }
            }

            Rectangle {
                background: cut-t.has-hover ? #f0f0f0 : transparent;
                height: 26px;
                border-radius: 4px;
                Text {
                    text: "Cut";
                    x: 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 13px;
                }

                Text {
                    text: "ctrl-x";
                    x: parent.width - self.width - 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 11px;
                    color: #888888;
                }

                cut-t := TouchArea {
                    clicked => {
                        menu_visible = false;
                        root.cut_selected_subgraph(root.backup_selected_indexes);
                    }
                }
            }

            Rectangle {
                background: del-t.has-hover ? #f0f0f0 : transparent;
                height: 26px;
                border-radius: 4px;
                Text {
                    text: "Delete";
                    x: 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 13px;
                }

                Text {
                    text: "ctrl-d";
                    x: parent.width - self.width - 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 11px;
                    color: #888888;
                }

                del-t := TouchArea {
                    clicked => {
                        if (root.active_selection_mode == "connection") {
                            root.delete_selected_connection();
                        } else if (root.active_selection_mode == "node" || root.backup_selected_indexes.length > 0) {
                            root.delete_selected_symbols(root.backup_selected_indexes);
                        }
                        root.selected_indexes = [];
                        root.backup_selected_indexes = [];
                        root.active_selection_mode = "";
                        root.select_connection(-1);
                        menu_visible = false;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #e8e8e8;
            }

            Rectangle {
                background: u.has-hover ? #f0f0f0 : transparent;
                height: 26px;
                border-radius: 4px;
                Text {
                    text: "Undo";
                    x: 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 13px;
                }

                Text {
                    text: "ctrl-z";
                    x: parent.width - self.width - 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 11px;
                    color: #888888;
                }

                u := TouchArea {
                    clicked => {
                        root.undo_action();
                        menu_visible = false;
                    }
                }
            }

            Rectangle {
                background: r.has-hover ? #f0f0f0 : transparent;
                height: 26px;
                border-radius: 4px;
                Text {
                    text: "Redo";
                    x: 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 13px;
                }

                Text {
                    text: "ctrl-y";
                    x: parent.width - self.width - 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 11px;
                    color: #888888;
                }

                r := TouchArea {
                    clicked => {
                        menu_visible = false;
                        root.redo_action();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #e8e8e8;
            }

            Rectangle {
                background: sel-t.has-hover ? #f0f0f0 : transparent;
                height: 26px;
                border-radius: 4px;
                Text {
                    text: "Select All";
                    x: 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 13px;
                }

                Text {
                    text: "ctrl-a";
                    x: parent.width - self.width - 8px;
                    vertical-alignment: center;
                    height: 100%;
                    font-size: 11px;
                    color: #888888;
                }

                sel-t := TouchArea {
                    clicked => {
                        root.select_all();
                        root.backup_selected_indexes = root.selected_indexes;
                        menu_visible = false;
                    }
                }
            }
        }
    }

    if (root.show_node_modal): Rectangle {

        width: parent.width;
        height: parent.height;
        background: #00000066;
        border-radius: 6px;
        TouchArea { }

        Rectangle {
            width: 520px;
            height: 480px;
            background: white;
            border-radius: 6px;
            border-width: 1px;
            border-color: #dcdcdc;
            clip: true;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                 Rectangle {
                            background: #dbe7f4;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #b0e6f8;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    Text {
                                        text: "Node Details";
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    LineEdit {
                                        placeholder-text: "Node Name";
                                        text: root.edit_label;

                                        edited => {
                                            root.edit_label = self.text;
                                        }
                                    }

                                    LineEdit {
                                        placeholder-text: "Node Value";
                                        text: root.edit_value;

                                        edited => {
                                            root.edit_value = self.text;
                                        }
                                    }
                                }
                            }
                        }

                ScrollView {

                    height: 350px;

                        VerticalLayout {

                        spacing: 10px;

                        Rectangle {
                            background: #edf9ef;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #d8f0dd;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    Text {
                                        text: "Input Ports";
                                        font-size: 12px;
                                        font-weight: 600;
                                    }

                                    Rectangle { }

                                    Button {
                                        text: "+ Add";

                                        clicked => {
                                            root.add_ip_port();
                                        }
                                    }
                                }

                                for i in root.ip_names.length: HorizontalLayout {
                                    spacing: 4px;

                                    ComboBox {
                                        model: ["Number", "String"];
                                        current-value: root.ip_types[i];
                                        selected(val) => {
                                            root.ip_types[i] = val;
                                        }
                                    }

                                    LineEdit {
                                        placeholder-text: "Name";
                                        text: root.ip_names[i];

                                        edited => {
                                            root.ip_names[i] = self.text;
                                        }
                                    }

                                    LineEdit {
                                        text: ip_values[i];

                                        edited(val) => { ip_values[i] = val; }
                                    }
                                }
                            }
                        }

                        Rectangle {

                            background: #e5f4f9;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #bae4fa;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                HorizontalLayout {
                                    Text {
                                        text: "Output Ports";
                                        font-size: 12px;
                                        font-weight: 600;
                                    }

                                    Rectangle { }

                                    Button {
                                        text: "+ Add";

                                        clicked => {
                                            root.add_op_port();
                                        }
                                    }
                                }

                                for i in root.op_names.length: HorizontalLayout {
                                    spacing: 4px;

                                    ComboBox {
                                        model: ["Number", "String"];
                                        current-value: root.op_types[i];
                                        selected(val) => {
                                            root.op_types[i] = val;
                                        }
                                    }

                                    LineEdit {
                                        placeholder-text: "Name";
                                        text: op_names[i];

                                        edited => {
                                            op_names[i] = self.text;
                                        }
                                    }

                                    LineEdit {
                                        placeholder-text: "Value";
                                        text: op_values[i];

                                        edited => {
                                            op_values[i] = self.text;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle { }

                    Button {
                        text: "Cancel";

                        clicked => {
                            root.show_node_modal = false;
                        }
                    }

                    Button {
                        text: "Save";
                        primary: true;
                        clicked => {

                            if (root.save_node_properties(        root.editing_index,        root.ip_ports,        root.op_ports,        root.edit_label,        root.ip_names,        root.ip_values,        root.op_names,        root.op_values,        root.ip_types,        root.op_types)) {

                                root.function_node_ip_ports = root.ip_ports;

                                root.function_node_op_ports = root.op_ports;

                                root.show_node_modal = false;
                            }
                        }
                    }
                }
            }
        }
    }

    if (root.show_port_configuration_modal): Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000044;

        TouchArea { }

        Rectangle {
            width: 360px;
            height: 240px;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e0e0e0;
            clip: true;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Port Configuration";
                    font-size: 16px;
                    font-weight: 700;
                    color: #222222;
                }

                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: "Input Ports:";
                        vertical-alignment: center;
                        font-size: 13px;
                        font-weight: 500;
                        color: #555555;
                        width: 80px;
                    }

                    Rectangle {
                        background: #f8f9fa;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #cccccc;
                        height: 32px;

                        TextInput {
                            text: root.temp_ip_ports;

                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;

                            x: 16px;
                            width: parent.width - 32px;

                            edited => {
                                root.temp_ip_ports = self.text.to-float();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: "Output Ports:";
                        vertical-alignment: center;
                        font-size: 13px;
                        font-weight: 500;
                        color: #555555;
                        width: 80px;
                    }

                    Rectangle {
                        background: #f8f9fa;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #cccccc;
                        height: 32px;

                        TextInput {
                            text: root.temp_op_ports;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            x: 16px;
                            width: parent.width - 32px;

                            edited => {
                                root.temp_op_ports = self.text.to-float();
                            }
                        }
                    }
                }

                Rectangle { }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Button {
                        text: "Close";
                        width: 85px;
                        height: 32px;
                        primary: true;
                        clicked => {
                            root.show_port_configuration_modal = false;
                        }
                    }

                    Button {
                        text: "Save";
                        width: 85px;
                        height: 32px;
                        primary: true;
                        clicked => {
                            root.function_node_ip_ports = root.temp_ip_ports.to-float();
                            root.function_node_op_ports = root.temp_op_ports.to-float();

                            root.show_port_configuration_modal = false;
                        }
                    }
                }
            }
        }
    }

    if (root.show_alert): Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000044;

        TouchArea { }

        Rectangle {
            width: 320px;
            height: 180px;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #dddddd;
            clip: true;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Notification";
                    font-size: 16px;
                    font-weight: 700;
                    color: #333333;
                }

                Text {
                    text: root.alert_message;
                    font-size: 14px;
                    color: #555555;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }

                HorizontalLayout {
                    alignment: center;

                    Button {
                        text: "Ok";
                        width: 100px;
                        primary: true;
                        clicked => {
                            root.show_alert = false;
                        }
                    }
                }
            }
        }
    }
}
