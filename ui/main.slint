import { Button } from "std-widgets.slint";

export struct SymbolEntry {
    name: string,
    label: string,
    value: string,
    x: float,
    y: float,
    node_type: string,
    bg_color: string,
    creation_mode: int,
}

export struct Connection {
    from_index: int,
    to_index: int,
    selected: bool,
    creation_mode: int,
    from_port: string,
    to_port: string,
}

struct LibraryItem {
    name: string,
    node_type: string,
}

component NodeSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode: 0;

    width: 120px;
    height: 40px;
    background: #e1f5fe.with-alpha(0.5);
    border-width: 1px;
    border-color: #0288d1;
    border-radius: 4px;

    if (root.creation_mode == 0 || root.creation_mode == 2): Rectangle {
        x: -5px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: input_touch.has-hover ? orange : #0288d1;
        input_touch := TouchArea {
            clicked => {
                root.port_clicked(true, "left");
            }
        }
    }

    if (root.creation_mode == 0 || root.creation_mode == 2): Rectangle {
        x: 115px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: output_touch.has-hover ? orange : #0288d1;
        output_touch := TouchArea {
            clicked => {
                root.port_clicked(false,"right");
            }
        }
    }

    if (root.creation_mode == 1 || root.creation_mode == 2): Rectangle {
        x: (parent.width / 2) - 5px;
        y: -5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: top_touch.has-hover ? orange : #0288d1;
        top_touch := TouchArea {
            clicked => {
                root.port_clicked(true, "top");
            }
        }
    }

    if (root.creation_mode == 1 || root.creation_mode == 2): Rectangle {
        x: (parent.width / 2) - 5px;
        y: parent.height - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: bottom_touch.has-hover ? orange : #0288d1;
        bottom_touch := TouchArea {
            clicked => {
                root.port_clicked(false,"bottom");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component InputConnectorSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode: 0;

    width: 60px;
    height: 40px;
    background: #bae2b1.with-alpha(0.5);
    border-width: 1px;
    border-color: #8ba47c;
    border-radius: 4px;

    Rectangle {
        x: -5px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: input_touch.has-hover ? orange : #8ba47c;
        input_touch := TouchArea {
            clicked => {
                root.port_clicked(true, "left");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component OutputConnectorSymbol inherits Rectangle {

    callback port_clicked(bool, string);

    in property <string> label: "Node";
    in property <int> creation_mode: 0;

    width: 60px;
    height: 40px;
    background: #bae2b1.with-alpha(0.5);
    border-width: 1px;
    border-color: #8ba47c;
    border-radius: 4px;

    Rectangle {
        x: 55px;
        y: 15px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: output_touch.has-hover ? orange : #8ba47c;
        output_touch := TouchArea {
            clicked => {
                root.port_clicked(false,"right");
            }
        }
    }

    Text {
        text: root.label;
        color: rgb(40, 40, 50);
        width: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {

    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1024px;
    min-height: 700px;
    in-out property <int> active_layout_mode: 0;

    callback vertical_layout();
    callback horizontal_layout();

    in-out property <bool> show_alert: false;
    in-out property <string> alert_message: "";
    public function trigger_alert(msg: string) {
        root.alert_message = msg;
        root.show_alert = true;
    }
    property <bool> common_expanded: false;
    property <bool> function_expanded: false;
    property <bool> parser_expanded: false;
    property <bool> storage_expanded: false;
    property <bool> dashboard_expanded: false;
    property <bool> network_expanded: false;
    property <bool> actions_expanded: false;
    property <bool> layout_expanded: false;
    property <bool> connectors_expanded: false;
    in-out property <[SymbolEntry]> all_symbols: [];

    in-out property <[Connection]> connections: [];

    in-out property <int> selected_index: -1;

    property <bool> prevent_placement: false;

    in-out property <bool> is_dragging: false;
    in-out property <string> drag_name: "";
    in-out property <int> creation_mode: 0;
    in-out property <string> drag_type: "";
    in-out property <string> bg_color: "";
    in-out property <float> drag_x: 0;
    in-out property <float> drag_y: 0;
    in-out property <bool> show_node_modal: false;

    in-out property <string> edit_label: "";
    in-out property <string> edit_value: "";

    in-out property <int> editing_index: -1;

    callback save_node_properties(int, string, string);

    callback select_library_symbol(string);
    callback place_symbol(string, string, string, float, float, int);

    callback update_symbol_position(int, float, float);

    callback delete_selected_symbol();

    callback clear_canvas();

    callback import_xml();
    callback handle_port_click(int, bool, int, string);

    callback select_connection(int);

    callback delete_selected_connection();
    callback save_flow();
    callback load_flow();

    HorizontalLayout {
        width: 100%;
        height: 100%;

        Rectangle {
            width: 260px;
            background: #f7f7f7;
            border-width: 1px;
            border-color: #dcdcdc;

            VerticalLayout {
                padding: 10px;
                spacing: 10px;

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: sidebar-content.min-height;
                    //clip: true;

                    sidebar-content := VerticalLayout {
                        alignment: start;
                        spacing: 10px;

                        Rectangle {
                            height: 36px;
                            background: rgb(166, 187, 207);
                            border-radius: 4px;

                            Text {
                                text: (root.common_expanded ? "▼ " : "▶ ") + "Common";
                                color: white;
                                font-weight: 700;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.common_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.common_expanded = !was_open;
                                }
                            }
                        }

                        if (root.common_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in [
                                { name: "Text", node_type: "ui_text" },
                                { name: "Button", node_type: "ui_button" },
                                { name: "Dropdown", node_type: "ui_dropdown" }
                            ]: Rectangle {
                                height: 35px;
                                background: common-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node.name;
                                    color: black;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                common-touch := TouchArea {
                                    moved => {
                                        root.is_dragging = true;
                                        root.drag_name = node.name;
                                        root.drag_type = node.node_type;
                                        root.select_library_symbol(node.name);
                                        root.drag_x = (self.mouse-x + parent.x) / 1px;
                                        root.drag_y = (self.mouse-y + parent.y) / 1px;
                                        root.creation_mode = root.active_layout_mode;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: rgb(253, 208, 162);
                            border-radius: 4px;

                            Text {
                                text: (root.function_expanded ? "▼ " : "▶ ") + "Function";
                                color: white;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.function_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.function_expanded = !was_open;
                                }
                            }
                        }

                        if (root.function_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in ["Switch", "Change", "Range", "Delay", "Trigger"]: Rectangle {
                                height: 35px;
                                background: function-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node;
                                    color: black;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                function_touch := TouchArea {
                                    moved => {
                                        root.is_dragging = true;
                                        root.drag_name = node;
                                        root.select_library_symbol(node);
                                        root.drag_x = (self.mouse-x + parent.x) / 1px;
                                        root.drag_y = (self.mouse-y + parent.y) / 1px;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: rgb(222, 189, 92);
                            border-radius: 4px;

                            Text {
                                text: (root.parser_expanded ? "▼ " : "▶ ") + "Parser";
                                color: white;
                                font-weight: 700;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.parser_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.parser_expanded = !was_open;
                                }
                            }
                        }

                        if (root.parser_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in ["Json", "Xml", "Csv", "Html"]: Rectangle {
                                height: 35px;
                                background: parser-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node;
                                    color: black;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                parser_touch := TouchArea {
                                    moved => {
                                        root.is_dragging = true;
                                        root.drag_name = node;
                                        root.select_library_symbol(node);
                                        root.drag_x = (self.mouse-x + parent.x) / 1px;
                                        root.drag_y = (self.mouse-y + parent.y) / 1px;
                                        root.creation_mode = root.active_layout_mode;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: burlywood;
                            border-radius: 4px;

                            Text {
                                text: (root.storage_expanded ? "▼ " : "▶ ") + "Storage";
                                color: white;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.storage_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.storage_expanded = !was_open;
                                }
                            }
                        }

                        if (root.storage_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in ["Text", "Button", "Dropdown"]: Rectangle {
                                height: 35px;
                                background: storage-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node;
                                    color: black;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                storage_touch := TouchArea {
                                    moved => {
                                        root.is_dragging = true;
                                        root.drag_name = node;
                                        root.select_library_symbol(node);
                                        root.drag_x = (self.mouse-x + parent.x) / 1px;
                                        root.drag_y = (self.mouse-y + parent.y) / 1px;
                                        root.creation_mode = root.active_layout_mode;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: rgb(119, 198, 204);
                            border-radius: 4px;

                            Text {
                                text: (root.dashboard_expanded ? "▼ " : "▶ ") + "Dashboard";
                                color: white;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.dashboard_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.dashboard_expanded = !was_open;
                                }
                            }
                        }

                        if (root.dashboard_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in ["Chart", "Gauge", "Slider"]: Rectangle {
                                height: 35px;
                                background: dashboard-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node;
                                    color: #222;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                dashboard_touch := TouchArea {
                                    moved => {
                                        root.is_dragging = true;
                                        root.drag_name = node;
                                        root.select_library_symbol(node);
                                        root.drag_x = (self.mouse-x + parent.x) / 1px;
                                        root.drag_y = (self.mouse-y + parent.y) / 1px;
                                        root.creation_mode = root.active_layout_mode;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: rgb(215, 215, 160);
                            border-radius: 4px;

                            Text {
                                text: (root.network_expanded ? "▼ " : "▶ ") + "Network";
                                color: white;
                                font-weight: 700;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.network_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.network_expanded = !was_open;
                                }
                            }
                        }

                        if (root.network_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in ["MQTT", "HTTP", "TCP"]: Rectangle {
                                height: 35px;
                                background: network-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }
                                Text {
                                    text: node;
                                    color: #222;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                network_touch := TouchArea {
                                    moved => {
                                        root.is_dragging = true;
                                        root.drag_name = node;
                                        root.select_library_symbol(node);
                                        root.drag_x = (self.mouse-x + parent.x) / 1px;
                                        root.drag_y = (self.mouse-y + parent.y) / 1px;
                                        root.creation_mode = root.active_layout_mode;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: #edd1d1;
                            Text {
                                text: (root.actions_expanded ? "▼ " : "▶ ") + "Actions";
                                color: white;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.actions_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.actions_expanded = !was_open;
                                }
                            }
                        }

                        if (root.actions_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in ["Delete Node", "Delete Wire", "Clear All", "Save Flow", "Load Flow"]: Rectangle {
                                height: 35px;
                                background: actions-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node;
                                    color: #222;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                actions-touch := TouchArea {
                                    clicked => {
                                        if (node == "Delete Wire") {
                                            root.delete_selected_connection();
                                        } else if (node == "Delete Node") {
                                            root.delete_selected_symbol();
                                        } else if (node == "Save Flow") {
                                            root.save_flow();
                                        } else if (node == "Load Flow") {
                                            root.load_flow();
                                        } else if (node == "Clear All") {
                                            root.clear_canvas();
                                        } else {
                                            root.is_dragging = true;
                                            root.drag_name = node;
                                            root.select_library_symbol(node);
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: #266df2;
                            border-radius: 4px;
                            Text {
                                text: (root.layout_expanded ? "▼ " : "▶ ") + "Layout";
                                color: white;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.layout_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.layout_expanded = !was_open;
                                }
                            }
                        }

                        if (root.layout_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in ["Horizontal", "Vertical", "Both"]: Rectangle {
                                height: 35px;
                                background: layout-touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node;
                                    color: #222;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                layout-touch := TouchArea {
                                    clicked => {
                                        if (node == "Horizontal") {
                                            root.active_layout_mode = 0;
                                            root.horizontal_layout();
                                        } else if (node == "Vertical") {
                                            root.active_layout_mode = 1;
                                            root.vertical_layout();
                                        } else if (node == "Both") {
                                            root.active_layout_mode = 2;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: #bbebb2;
                            Text {
                                text: (root.connectors_expanded ? "▼ " : "▶ ") + "Connectors";
                                color: white;
                                x: 10px;
                                vertical-alignment: center;
                                height: parent.height;
                            }

                            TouchArea {
                                clicked => {
                                    let was_open = root.connectors_expanded;
                                    root.common_expanded = false;
                                    root.function_expanded = false;
                                    root.network_expanded = false;
                                    root.actions_expanded = false;
                                    root.dashboard_expanded = false;
                                    root.storage_expanded = false;
                                    root.parser_expanded = false;
                                    root.layout_expanded = false;
                                    root.connectors_expanded = !was_open;
                                }
                            }
                        }

                        if (root.connectors_expanded): VerticalLayout {
                            spacing: 6px;
                            for node in [{ name: "A", node_type: "ip_connector" }, { name: "B", node_type: "op_connector" }]: Rectangle {
                                height: 35px;
                                background: connectors_touch.has-hover ? #e2dfed : #edebf4;
                                border-radius: 4px;
                                animate background { duration: 150ms; }

                                Text {
                                    text: node.name;
                                    color: #222;
                                    x: 10px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }

                                connectors_touch := TouchArea {
                                    moved => {
                                        root.is_dragging = true;
                                        root.drag_name = node.name;
                                        root.drag_type = node.node_type;
                                        root.select_library_symbol(node.name);
                                        root.drag_x = (self.mouse-x + parent.x) / 1px;
                                        root.drag_y = (self.mouse-y + parent.y) / 1px;
                                        root.creation_mode = root.active_layout_mode;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 40px;
                    vertical-stretch: 0;
                    HorizontalLayout {
                        spacing: 10px;

                        // Delete Button
    Rectangle {
                            background: #e06c75; // Reddish
        border-radius: 4px;
                            Button {
                                text: "Del ";
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    if (root.selected_index != -1) {
                                        root.delete_selected_symbol();
                                    } else {
                        // Otherwise fall back to deleting the selected wire/connection
                        root.delete_selected_connection();
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: #d19a66; // Orange/Brown
        border-radius: 4px;
                            Button {
                                text: "Clr ";
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.clear_canvas();
                                }
                            }
                        }

                        // Import Button
    Rectangle {
                            background: #61afef; // Soft Blue
        border-radius: 4px;
                            Button {
                                text: "Save";
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.save_flow();
                                }
                            }
                        }

                        // Export Button
    Rectangle {
                            background: #98c379; // Greenish
        border-radius: 4px;
                            Button {
                                text: "Load";
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.load_flow();
                                }
                            }
                        }

                        // Clear Button
  
}
                }
            }
        }

        Rectangle {
            background: #f8f5f5;
            clip: true;

            for i in 250: Rectangle {
                x: (i * 15) * 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: #e0e0e0;
            }

            for i in 150: Rectangle {
                x: 0;
                y: (i * 15) * 1px;
                width: parent.width;
                height: 1px;
                background: #e0e0e0;
            }

            TouchArea {
                moved => {
                    if (root.is_dragging) {
                        root.drag_x = self.mouse-x / 1px;
                        root.drag_y = self.mouse-y / 1px;
                    }
                }

                clicked => {
                    if (root.is_dragging) {
                        let is_connector = root.drag_name == "A" || root.drag_name == "B";
                        let shape_w = is_connector ? 60 : 120;
                        let shape_h = is_connector ? 40 : 40;
                        let drop_x = root.drag_x - (shape_w / 2);
                        let drop_y = root.drag_y - (shape_h / 2);
                        root.place_symbol(
                            root.drag_name,   
                            root.drag_type,                    
                            "#0d6efd",          
                            drop_x,                          
                            drop_y, 
                            root.active_layout_mode);
                        root.is_dragging = false;
                    } else if (root.selected_index != -1) {
                        root.selected_index = -1;
                    }
                }

                if (root.is_dragging): Rectangle {
                    property <bool> is_InputConnector: root.drag_type == "ip_connector";
                    property <bool> is_OutConnector: root.drag_type == "op_connector";
                    width: is_InputConnector || is_OutConnector ? 60px : 120px;
                    height: is_InputConnector || is_OutConnector ? 40px : 40px;
                    x: root.drag_x * 1px - (self.width / 2);
                    y: root.drag_y * 1px - (self.height / 2);
                    opacity: 0.5;

                    if (is_InputConnector): InputConnectorSymbol {
                        width: 100%;
                        height: 100%;
                        label: root.drag_name;
                    }
                    if (is_OutConnector): OutputConnectorSymbol {
                        width: 100%;
                        height: 100%;
                        label: root.drag_name;
                    }
                    if (!is_InputConnector && !is_OutConnector): NodeSymbol {
                        width: 100%;
                        height: 100%;
                        label: root.drag_name;
                        creation_mode: root.active_layout_mode;
                    }
                }

                for item[i] in root.all_symbols: Rectangle {
                    z: 2;
                    property <bool> is_InputConnector: item.node_type == "ip_connector";
                    property <bool> is_OutConnector: item.node_type == "op_connector";
                    property <bool> is_connector: is_InputConnector || is_OutConnector;
                    width: is_connector ? 60px : 120px;
                    height: is_connector ? 40px : 40px;
                    x: item.x * 1px - 60px;
                    y: item.y * 1px - 20px;

                    if (root.selected_index == i): Rectangle {
                        border-width: 3px;
                        border-radius: 4px;
                        border-color: #0288d1;
                    }

                    if (is_InputConnector): InputConnectorSymbol {
                        width: 100%;
                        height: 100%;
                        label: item.label == "" ? item.name : item.label;
                        port_clicked(is_input, port_name) => {
                            root.handle_port_click(i, is_input, item.creation_mode, port_name);
                        }
                    }
                    if (is_OutConnector): OutputConnectorSymbol {
                        width: 100%;
                        height: 100%;
                        label: item.label == "" ? item.name : item.label;
                        port_clicked(is_input, port_name) => {
                            root.handle_port_click(i, is_input, item.creation_mode, port_name);
                        }
                    }
                    if (!is_connector): NodeSymbol {
                        width: 100%;
                        height: 100%;
                        label: item.label == "" ? item.name : item.label;
                        creation_mode: item.creation_mode;
                        port_clicked(is_input, port_name) => {
                            root.handle_port_click(i, is_input, item.creation_mode, port_name);
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.selected_index = i;
                        }
                        double-clicked => {
                            root.selected_index = i;
                            root.prevent_placement = true;
                            root.editing_index = i;
                            root.edit_label = item.label;
                            root.edit_value = item.value;
                            root.show_node_modal = true;
                        }
                        moved => {
                            root.update_symbol_position(
                                i,
                                (self.mouse-x + parent.x + 60px) / 1px,
                                (self.mouse-y + parent.y + 20px) / 1px);
                        }
                    }
                }

                for conn[index] in root.connections: Rectangle {

                    /*  property <string> source_name: root.all_symbols[conn.from_index].node_type;
                    property <string> target_name: root.all_symbols[conn.to_index].node_type;

                    Text {
                        text: "Wire " + index + ": From (" + source_name + ") to (" + target_name + ")";
                        color: #ff00ff;
                        font-size: 11px;
                        y: -18px; // Positions it right above the line
                    }    */

                    property <bool> isOutputConnector: root.all_symbols[conn.from_index].node_type == "op_connector";
                    property <bool> isInputConnector: root.all_symbols[conn.to_index].node_type == "ip_connector";
                    property <float> from_hw: isOutputConnector ? 0 : 60;
                    property <float> to_hw: isInputConnector ? 60 : 60;
                    property <float> sx: (conn.from_port == "right") ? (root.all_symbols[conn.from_index].x + from_hw) : (conn.from_port == "left") ? (root.all_symbols[conn.from_index].x - from_hw) : (root.all_symbols[conn.from_index].x);
                    property <float> sy: (conn.from_port == "right" || conn.from_port == "left") ? (root.all_symbols[conn.from_index].y) : (conn.from_port == "bottom") ? (root.all_symbols[conn.from_index].y + 20) : (root.all_symbols[conn.from_index].y - 20);
                    property <float> tx: (conn.to_port == "right") ? (root.all_symbols[conn.to_index].x + to_hw) : (conn.to_port == "left") ? (root.all_symbols[conn.to_index].x - to_hw) : (root.all_symbols[conn.to_index].x);
                    property <float> ty: (conn.to_port == "right" || conn.to_port == "left") ? (root.all_symbols[conn.to_index].y) : (conn.to_port == "bottom") ? (root.all_symbols[conn.to_index].y + 20) : (root.all_symbols[conn.to_index].y - 20);

                    property <float> left: Math.min(sx, tx);
                    property <float> top: Math.min(sy, ty);
                    property <float> pad: 40;

                    property <bool> is_target_above: ty < sy;

                    property <float> pw: Math.max(Math.abs(tx - sx), 1) + (pad * 2);
                    property <float> ph: (Math.max(Math.abs(ty - sy), 1) + (pad * 2)) + (is_target_above ? 40 : 0);

                    x: (left - pad) * 1px;
                    y: (top - pad) * 1px;
                    width: pw * 1px;
                    height: ph * 1px;
                    background: transparent;
                    z: 1;

                    Path {
                        visible: (conn.from_port == "right" && conn.to_port == "top");
                        width: parent.width;
                        height: parent.height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: pw;
                        viewbox-height: ph;
                        fill: transparent;
                        stroke: orange;
                        stroke-width: conn.selected ? 3px : 2px;

                        property <float> local_sx: sx - left + pad;
                        property <float> local_sy: sy - top + pad;
                        property <float> local_tx: tx - left + pad;
                        property <float> local_ty: ty - top + pad;

                        property <float> center_offset: -2;
                        property <float> adjusted_sy: local_sy + center_offset + 2;

                        property <bool> is_target_above: ty < sy;
                        property <bool> is_target_left: tx < sx;
                        property <bool> is_straight_vertical: Math.abs(local_sx - local_tx) < 2;

                        property <float> wp_x1: is_straight_vertical ? local_tx : (local_sx + 25);

                        property <float> wp_y1: is_straight_vertical ? local_ty : (is_target_left ? (is_target_above ? (local_ty - 30) : (local_sy + 40)) : (is_target_above ? (local_ty - 30) : (adjusted_sy + (local_ty - adjusted_sy) / 2)));

                        property <float> wp_x2: is_straight_vertical ? local_tx : local_tx;

                        MoveTo {
                            x: local_sx;
                            y: adjusted_sy;
                        }

                        LineTo {
                            x: wp_x1;
                            y: adjusted_sy;
                        }

                        LineTo {
                            x: wp_x1;
                            y: wp_y1;
                        }

                        LineTo {
                            x: wp_x2;
                            y: wp_y1;
                        }

                        LineTo {
                            x: wp_x2;
                            y: local_ty;
                        }
                    }

                    Path {
                        visible: (conn.from_port == "bottom" && conn.to_port == "left");
                        width: parent.width;
                        height: parent.height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: pw;
                        viewbox-height: ph;
                        fill: transparent;
                        stroke: orange;
                        stroke-width: conn.selected ? 3px : 2px;
                        property <bool> is_forward: tx >= sx;
                        property <float> local_sx: (sx - left + pad) + 1;
                        property <float> local_sy: sy - top + pad;
                        property <float> local_tx: tx - left + pad;
                        property <float> local_ty: ty - top + pad - 2;
                        property <float> center_offset: -2;
                        property <float> adjusted_sy: local_sy + center_offset;
                        property <float> adjusted_ty: local_ty + center_offset + 2;

                        property <bool> is_straight_line: Math.abs(local_sx - local_tx) < 2;

                        property <float> wp_y1: is_straight_line ? adjusted_ty : (local_sy + 40);
                        property <float> wp_x: is_straight_line ? local_tx : (local_tx - 40);

                        MoveTo {
                            x: local_sx;
                            y: local_sy;
                        }

                        LineTo {
                            x: local_sx;
                            y: wp_y1;
                        }

                        LineTo {
                            x: wp_x;
                            y: wp_y1;
                        }

                        LineTo {
                            x: wp_x;
                            y: is_straight_line ? adjusted_ty : (adjusted_ty + 1);
                        }

                        LineTo {
                            x: local_tx;
                            y: is_straight_line ? adjusted_ty : (adjusted_ty + 1);
                        }
                    }

                    Path {
                        visible: (conn.from_port == "right" && conn.to_port == "left");
                        width: parent.width;
                        height: parent.height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: pw;
                        viewbox-height: ph;
                        fill: transparent;
                        stroke: orange;
                        stroke-width: conn.selected ? 3px : 2px;
                        property <bool> is_forward: tx >= sx;
                        property <float> local_sx: sx - left + pad;
                        property <float> local_sy: sy - top + pad;
                        property <float> local_tx: tx - left + pad;
                        property <float> local_ty: ty - top + pad;
                        property <float> center_offset: -2;
                        property <float> adjusted_sy: local_sy + center_offset + 2;
                        property <float> adjusted_ty: local_ty + center_offset + 2;
                        property <bool> is_mixed_route: (conn.from_port == "right" || conn.from_port == "left") && (conn.to_port == "top" || conn.to_port == "bottom");

                        property <bool> is_straight_line: Math.abs(adjusted_sy - adjusted_ty) < 2;

                        property <float> wp_x1: is_mixed_route ? (local_sx + 40) : (is_forward ? (local_sx + (local_tx - local_sx) / 2) : (local_sx + 40));
                        property <float> wp_y: is_straight_line ? adjusted_sy : (is_mixed_route ? (adjusted_sy + (adjusted_ty - adjusted_sy) / 2) : (is_forward ? adjusted_ty : (adjusted_sy + (adjusted_ty - adjusted_sy) / 2)));
                        property <float> wp_x2: is_mixed_route ? local_tx : (is_forward ? (local_sx + (local_tx - local_sx) / 2) : (local_tx - 40));

                        MoveTo {
                            x: local_sx;
                            y: adjusted_sy;
                        }

                        LineTo {
                            x: wp_x1;
                            y: is_straight_line ? adjusted_sy : adjusted_sy;
                        }

                        LineTo {
                            x: wp_x1;
                            y: wp_y;
                        }

                        LineTo {
                            x: wp_x2;
                            y: wp_y;
                        }

                        LineTo {
                            x: wp_x2;
                            y: is_straight_line ? adjusted_sy : adjusted_ty;
                        }

                        LineTo {
                            x: local_tx;
                            y: is_straight_line ? adjusted_sy : adjusted_ty;
                        }
                    }

                    Path {
                        visible: (conn.from_port == "bottom" && conn.to_port == "top");
                        width: parent.width;
                        height: parent.height;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: pw;
                        viewbox-height: ph;
                        fill: transparent;
                        stroke: orange;
                        stroke-width: conn.selected ? 3px : 2px;

                        property <float> local_sx: sx - left + pad;
                        property <float> local_sy: sy - top + pad;
                        property <float> local_tx: tx - left + pad;
                        property <float> local_ty: ty - top + pad;

                        property <float> adjusted_sx: local_sx;
                        property <float> adjusted_tx: local_tx;

                        property <float> adjusted_ty: local_ty;

                        property <bool> is_straight_vertical: Math.abs(adjusted_sx - adjusted_tx) < 2;
                        property <bool> is_target_above: ty < sy;

                        property <float> wp_y1: is_straight_vertical ? adjusted_ty : (is_target_above ? (local_sy + 40) : (local_sy + (adjusted_ty - local_sy) / 2));
                        property <float> side_offset: (is_straight_vertical || !is_target_above) ? 0 : 90;
                        property <float> approach_offset: (is_straight_vertical || !is_target_above) ? 0 : -30;

                        MoveTo {
                            x: adjusted_sx;
                            y: local_sy;
                        }

                        LineTo {
                            x: adjusted_sx;
                            y: wp_y1;
                        }

                        LineTo {
                            x: is_straight_vertical ? adjusted_tx : (adjusted_tx + side_offset);
                            y: wp_y1;
                        }

                        LineTo {
                            x: is_straight_vertical ? adjusted_tx : (adjusted_tx + side_offset);
                            y: is_straight_vertical ? adjusted_ty : (adjusted_ty + approach_offset);
                        }

                        LineTo {
                            x: adjusted_tx;
                            y: is_straight_vertical ? adjusted_ty : (adjusted_ty + approach_offset);
                        }

                        LineTo {
                            x: adjusted_tx;
                            y: adjusted_ty;
                        }
                    }

                    if (conn.from_port == "right" && conn.to_port == "top"): TouchArea {
                        property <float> local_sx: sx - left + pad;
                        property <float> local_sy: sy - top + pad;
                        property <float> local_tx: tx - left + pad;
                        property <float> local_ty: ty - top + pad;

                        property <float> center_offset: -2;
                        property <float> adjusted_sy: local_sy + center_offset + 2;

                        property <bool> is_target_above: ty < sy;
                        property <bool> is_target_left: tx < sx;
                        property <bool> is_straight_vertical: Math.abs(local_sx - local_tx) < 2;

                        // --- MATCHES THE DRAWING PATH ROUTING EXACTLY ---
    property <float> wp_x1: is_straight_vertical ? local_tx : (local_sx + 25);
                        property <float> wp_y1: is_straight_vertical ? local_ty : (is_target_left ? (is_target_above ? (local_ty - 30) : (local_sy + 40)) : (is_target_above ? (local_ty - 30) : (adjusted_sy + (local_ty - adjusted_sy) / 2)));
                        property <float> wp_x2: local_tx;

                        // Dynamic bounding layout calculation for the click zone
    x: (Math.min(local_sx, Math.min(wp_x1, wp_x2)) - 10) * 1px;
                        y: (Math.min(adjusted_sy, Math.min(wp_y1, local_ty)) - 10) * 1px;
                        width: (Math.max(local_sx, Math.max(wp_x1, wp_x2)) - Math.min(local_sx, Math.min(wp_x1, wp_x2)) + 20) * 1px;
                        height: (Math.max(adjusted_sy, Math.max(wp_y1, local_ty)) - Math.min(adjusted_sy, Math.min(wp_y1, local_ty)) + 20) * 1px;

                        clicked => {
                            root.select_connection(index);
                            root.selected_index = -1;
                        }
                    }
                    if (conn.from_port == "bottom" && conn.to_port == "top"): TouchArea {
                        property <float> local_sx: sx - left + pad;
                        property <float> local_sy: sy - top + pad;
                        property <float> local_tx: tx - left + pad;
                        property <float> local_ty: ty - top + pad;

                        // Perfect vertical port centering alignment corrections
    property <float> adjusted_sx: local_sx + 1;
                        property <float> adjusted_tx: local_tx + 1;
                        property <float> adjusted_ty: local_ty;

                        // Correct vertical routing check (compares horizontal X-coordinates)
    property <bool> is_straight_vertical: Math.abs(adjusted_sx - adjusted_tx) < 2;
                        property <bool> is_target_above: ty < sy;

                        property <float> side_offset: (is_straight_vertical || !is_target_above) ? 0 : 90;
                        property <float> approach_offset: (is_straight_vertical || !is_target_above) ? 0 : -30;
                        property <float> wp_y1: is_straight_vertical ? adjusted_ty : (is_target_above ? (local_sy + 40) : (local_sy + (adjusted_ty - local_sy) / 2));

                        // Bounding hit-box calculations matching the clean path flow
    x: (Math.min(adjusted_sx, is_straight_vertical ? adjusted_tx : (adjusted_tx + side_offset)) - 10) * 1px;
                        y: (Math.min(local_sy, adjusted_ty) - 10) * 1px;
                        width: (is_straight_vertical ? 20 : (Math.abs((adjusted_tx + side_offset) - adjusted_sx) + 20)) * 1px;
                        height: (Math.abs(adjusted_ty - local_sy) + 20) * 1px;

                        clicked => {
                            root.select_connection(index);
                            root.selected_index = -1;
                        }
                    }
                }
            }
        }
    }

    if (root.show_node_modal): Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000044;

        TouchArea { /* Blocks clicks from hitting the canvas underneath */ }

        // Centered modal layout frame
    Rectangle {
            width: 360px;
            height: 240px;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #e0e0e0;
        // Drop a subtle drop-shadow effect if supported by your backend container, or leave clip for crisp edges:
        clip: true;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                Text {
                    text: "Edit Node Properties";
                    font-size: 16px;
                    font-weight: 700;
                    color: #222222;
                }

                // --- Form Input 1: Label ---
            HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: "Label:";
                        vertical-alignment: center;
                        font-size: 13px;
                        font-weight: 500;
                        color: #555555;
                        width: 50px;
                    }

                    // Visual container wrapper for TextInput
                Rectangle {
                        background: #f8f9fa;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #cccccc;
                        height: 32px;

                        TextInput {
                            text: root.edit_label;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                        // Use local element constraints or custom padding adjustments
                        x: 8px;
                            width: parent.width - 16px;

                            edited => {
                                root.edit_label = self.text;
                            }
                        }
                    }
                }

                // --- Form Input 2: Value ---
            HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: "Value:";
                        vertical-alignment: center;
                        font-size: 13px;
                        font-weight: 500;
                        color: #555555;
                        width: 50px;
                    }

                    // Visual container wrapper for TextInput
                Rectangle {
                        background: #f8f9fa;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #cccccc;
                        height: 32px;

                        TextInput {
                            text: root.edit_value;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            x: 8px;
                            width: parent.width - 16px;

                            edited => {
                                root.edit_value = self.text;
                            }
                        }
                    }
                }

                // Dynamic layout spacer to push actions safely down
            Rectangle { }

                // --- Modal Actions ---
            HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Button {
                        width: 85px;
                        height: 32px;
                        primary: true;
                        clicked => {
                            root.show_node_modal = false;
                        }
                    }

                    Button {
                        text: "Save";
                        width: 85px;
                        height: 32px;
                        primary: true;
                        clicked => {
                            root.save_node_properties(root.editing_index, root.edit_label, root.edit_value);
                            root.show_node_modal = false;
                        }
                    }
                }
            }
        }
    }

    if (root.show_alert): Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000044;

        TouchArea { /* Blocks clicks from hitting the canvas underneath */ }

        Rectangle {
            width: 320px;
            height: 180px; // Slightly increased to fit padding nicely
        background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #dddddd;
            clip: true;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Notification";
                    font-size: 16px;
                    font-weight: 700;
                    color: #333333;
                }

                // Let the message text expand to fill the middle space
            Text {
                    text: root.alert_message;
                    font-size: 14px;
                    color: #555555;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }

                // Horizontal layout forces the button to respect its own width 
            // instead of stretching across the entire dialog width
            HorizontalLayout {
                    alignment: center; // Centers the button horizontally
                
                Button {
                        text: "Ok";
                        width: 100px;  // Using a fixed size looks much cleaner on small dialogs
                    height: 36px;
                        primary: true; // Standard Slint way to make it pop (or style manually)
                    
                    clicked => {
                            root.show_alert = false;
                        }
                    }
                }
            }
        }
    }
}
